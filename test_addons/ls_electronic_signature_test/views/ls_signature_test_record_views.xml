<odoo>

    <record id="view_ls_signature_test_record_list" model="ir.ui.view">
        <field name="name">ls.signature.test.record.list</field>
        <field name="model">ls.signature.test.record</field>
        <field name="arch" type="xml">
            <list string="Signable Test Records">
                <field name="name"/>
                <field name="state"/>
                <field name="quantity"/>
                <field name="ls_signature_count" string="Signatures"/>
                <field name="ls_signature_current" string="Current"/>
            </list>
        </field>
    </record>

    <record id="view_ls_signature_test_record_form" model="ir.ui.view">
        <field name="name">ls.signature.test.record.form</field>
        <field name="model">ls.signature.test.record</field>
        <field name="arch" type="xml">
            <form string="Signable Test Record">
                <header>
                    <button name="action_ls_sign" type="object" string="Sign"
                            class="btn-primary"/>
                    <button name="action_ls_request_signature" type="object"
                            string="Request Signature"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ls_view_signatures" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="ls_signature_count" widget="statinfo"
                                   string="Signatures"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="ls_signature_count == 0 or ls_signature_current">
                        This record changed after its most recent signature.
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="quantity"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="ls_signature_current" invisible="1"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Electronic Signatures">
                        <field name="ls_signature_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="meaning_name"/>
                                <field name="signer_name"/>
                                <field name="signed_at"/>
                                <field name="is_current"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ls_signature_test_record" model="ir.actions.act_window">
        <field name="name">Signable Test Records</field>
        <field name="res_model">ls.signature.test.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ls_signature_test_record"
              name="Signable Test Records"
              parent="ls_electronic_signature.menu_ls_signature_operations"
              action="action_ls_signature_test_record"
              sequence="99"/>

</odoo>
