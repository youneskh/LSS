<odoo>

    <record id="view_ls_validation_master_plan_list" model="ir.ui.view">
        <field name="name">ls.validation.master.plan.list</field>
        <field name="model">ls.validation.master.plan</field>
        <field name="arch" type="xml">
            <list string="Validation Master Plans"
                  decoration-muted="state in ('superseded', 'cancelled')"
                  decoration-success="state == 'active'">
                <field name="reference"/>
                <field name="version"/>
                <field name="name"/>
                <field name="author_id" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="effective_date"/>
                <field name="next_review_date" optional="show"/>
                <field name="protocol_count" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_validation_master_plan_form" model="ir.ui.view">
        <field name="name">ls.validation.master.plan.form</field>
        <field name="model">ls.validation.master.plan</field>
        <field name="arch" type="xml">
            <form string="Validation Master Plan">
                <header>
                    <button name="action_submit_review" type="object"
                            string="Submit for Review" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_back_to_draft" type="object"
                            string="Back to Draft"
                            invisible="state != 'review'"/>
                    <button name="action_approve" type="object"
                            string="Approve and Sign" class="btn-primary"
                            invisible="state != 'review'"
                            groups="ls_validation.group_ls_validation_approver"/>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_new_version" type="object"
                            string="New Version"
                            invisible="state not in ('approved', 'active')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('active', 'superseded', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_protocols" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="protocol_count" widget="statinfo"
                                   string="Protocols"/>
                        </button>
                        <button name="action_open_signatures" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="signature_count" widget="statinfo"
                                   string="Signatures"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Title of the plan"/>
                        </h2>
                    </div>
                    <group>
                        <group name="control" string="Document Control">
                            <field name="version"/>
                            <field name="previous_version_id"
                                   invisible="not previous_version_id"/>
                            <field name="author_id"/>
                            <field name="reviewer_id"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="approval_date"
                                   invisible="not approval_date"/>
                        </group>
                        <group name="validity" string="Validity">
                            <field name="effective_date"/>
                            <field name="review_interval_months"/>
                            <field name="next_review_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope" name="scope">
                            <field name="scope"
                                   placeholder="Sites, systems and processes covered."/>
                        </page>
                        <page string="Strategy" name="strategy">
                            <field name="strategy"
                                   placeholder="Risk based approach and deliverables."/>
                        </page>
                        <page string="Responsibilities" name="responsibilities">
                            <field name="responsibilities"/>
                        </page>
                        <page string="Items in Scope" name="items">
                            <field name="item_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="item_type"/>
                                    <field name="validation_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Protocols" name="protocols">
                            <field name="protocol_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="protocol_type"/>
                                    <field name="item_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Electronic Signatures" name="signatures">
                            <field name="signature_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="signed_on"/>
                                    <field name="user_id"/>
                                    <field name="meaning"/>
                                    <field name="reason"/>
                                    <field name="signature_hash"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ls_validation_master_plan_search" model="ir.ui.view">
        <field name="name">ls.validation.master.plan.search</field>
        <field name="model">ls.validation.master.plan</field>
        <field name="arch" type="xml">
            <search string="Validation Master Plans">
                <field name="reference"/>
                <field name="name"/>
                <field name="author_id"/>
                <filter name="filter_active_plans" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_in_approval" string="In Approval"
                        domain="[('state', 'in', ('draft', 'review'))]"/>
                <filter name="filter_review_due" string="Review Due"
                        domain="[('next_review_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                                    <filter name="group_by_state" string="Status"
                        context="{'group_by': 'state'}"/>
                    <filter name="group_by_author" string="Author"
                        context="{'group_by': 'author_id'}"/>
                    <filter name="group_by_effective" string="Effective Month"
                        context="{'group_by': 'effective_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_validation_master_plan" model="ir.actions.act_window">
        <field name="name">Validation Master Plans</field>
        <field name="res_model">ls.validation.master.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_validation_master_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Validation Master Plan
            </p>
            <p>
                The master plan declares the scope, the strategy and the
                responsibilities of a validation programme.
            </p>
        </field>
    </record>

</odoo>
