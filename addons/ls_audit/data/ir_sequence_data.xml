<odoo>
    <data noupdate="1">

        <record id="seq_ls_audit_program" model="ir.sequence">
            <field name="name">Audit Programme</field>
            <field name="code">ls.audit.program</field>
            <field name="prefix">APG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ls_audit_schedule" model="ir.sequence">
            <field name="name">Audit</field>
            <field name="code">ls.audit.schedule</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ls_audit_finding" model="ir.sequence">
            <field name="name">Audit Finding</field>
            <field name="code">ls.audit.finding</field>
            <field name="prefix">FND/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ls_audit_report" model="ir.sequence">
            <field name="name">Audit Report</field>
            <field name="code">ls.audit.report</field>
            <field name="prefix">ARP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
