<odoo>

    <record id="view_ls_audit_type_list" model="ir.ui.view">
        <field name="name">ls.audit.type.list</field>
        <field name="model">ls.audit.type</field>
        <field name="arch" type="xml">
            <list string="Audit Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_external"/>
                <field name="default_checklist_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ls_audit_type_form" model="ir.ui.view">
        <field name="name">ls.audit.type.form</field>
        <field name="model">ls.audit.type</field>
        <field name="arch" type="xml">
            <form string="Audit Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Internal System Audit"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="is_external"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="default_checklist_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_audit_type_search" model="ir.ui.view">
        <field name="name">ls.audit.type.search</field>
        <field name="model">ls.audit.type</field>
        <field name="arch" type="xml">
            <search string="Audit Types">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_internal" string="Internal" domain="[('is_external', '=', False)]"/>
                <filter name="filter_external" string="External" domain="[('is_external', '=', True)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                                    <filter name="group_is_external" string="Scope" context="{'group_by': 'is_external'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_audit_type" model="ir.actions.act_window">
        <field name="name">Audit Types</field>
        <field name="res_model">ls.audit.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_audit_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first audit type</p>
            <p>Audit types classify audit engagements, for example internal system audit, supplier audit or regulatory inspection.</p>
        </field>
    </record>

</odoo>
