<odoo>

    <record id="ls_training_requirement_list_view" model="ir.ui.view">
        <field name="name">ls.training.requirement.list</field>
        <field name="model">ls.training.requirement</field>
        <field name="arch" type="xml">
            <list string="Training Requirements" editable="bottom">
                <field name="course_id" options="{'no_create': True}"/>
                <field name="job_id" options="{'no_create': True}"/>
                <field name="department_id" options="{'no_create': True}"/>
                <field name="employee_id" options="{'no_create': True}"/>
                <field name="mandatory"/>
                <field name="grace_days"/>
                <field name="target_employee_count"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ls_training_requirement_form_view" model="ir.ui.view">
        <field name="name">ls.training.requirement.form</field>
        <field name="model">ls.training.requirement</field>
        <field name="arch" type="xml">
            <form string="Training Requirement">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_target_employees"
                                type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="target_employee_count"
                                   widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group name="course_group" string="Required Course">
                            <field name="course_id"
                                   options="{'no_create': True}"/>
                            <field name="mandatory"/>
                            <field name="grace_days"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group name="target_group" string="Target Population">
                            <field name="job_id"
                                   options="{'no_create': True}"
                                   readonly="employee_id != False"/>
                            <field name="department_id"
                                   options="{'no_create': True}"
                                   readonly="employee_id != False"/>
                            <field name="employee_id"
                                   options="{'no_create': True}"
                                   readonly="job_id != False or department_id != False"/>
                        </group>
                    </group>
                    <group name="note_group" string="Justification">
                        <field name="note" nolabel="1"
                               placeholder="Why is this training required for this population?"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ls_training_requirement_search_view" model="ir.ui.view">
        <field name="name">ls.training.requirement.search</field>
        <field name="model">ls.training.requirement</field>
        <field name="arch" type="xml">
            <search string="Training Requirements">
                <field name="course_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <filter name="filter_mandatory" string="Mandatory"
                        domain="[('mandatory', '=', True)]"/>
                <filter name="filter_by_role" string="Role Based"
                        domain="[('employee_id', '=', False)]"/>
                <filter name="filter_individual" string="Individual"
                        domain="[('employee_id', '!=', False)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                                    <filter name="group_by_course" string="Course"
                        context="{'group_by': 'course_id'}"/>
                    <filter name="group_by_job" string="Job Position"
                        context="{'group_by': 'job_id'}"/>
                    <filter name="group_by_department" string="Department"
                        context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <record id="ls_training_requirement_action"
            model="ir.actions.act_window">
        <field name="name">Training Requirements</field>
        <field name="res_model">ls.training.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="ls_training_requirement_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first training requirement
            </p>
            <p>
                Requirements state which courses a job position, a
                department or a named employee must hold. They are the
                source of the training matrix and of the compliance rate.
            </p>
        </field>
    </record>

</odoo>
