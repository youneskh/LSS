<odoo>

    <record id="ls_training_course_list_view" model="ir.ui.view">
        <field name="name">ls.training.course.list</field>
        <field name="model">ls.training.course</field>
        <field name="arch" type="xml">
            <list string="Training Courses"
                  decoration-muted="state == 'obsolete'"
                  decoration-success="state == 'approved'">
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="course_type"/>
                <field name="delivery_mode"/>
                <field name="duration_hours" sum="Total Hours"/>
                <field name="validity_months"/>
                <field name="session_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'review'"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="ls_training_course_form_view" model="ir.ui.view">
        <field name="name">ls.training.course.form</field>
        <field name="model">ls.training.course</field>
        <field name="arch" type="xml">
            <form string="Training Course">
                <header>
                    <button name="action_submit_review" type="object"
                            string="Submit for Review" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ls_training.group_ls_training_manager"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'review'"
                            groups="ls_training.group_ls_training_manager"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="ls_training.group_ls_training_manager"/>
                    <button name="action_set_obsolete" type="object"
                            string="Make Obsolete"
                            invisible="state != 'approved'"
                            groups="ls_training.group_ls_training_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="session_count" widget="statinfo"
                                   string="Sessions"/>
                        </button>
                        <button name="action_view_certifications"
                                type="object" class="oe_stat_button"
                                icon="fa-certificate">
                            <field name="certification_count"
                                   widget="statinfo"
                                   string="Certifications"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Obsolete"
                            bg_color="text-bg-danger"
                            invisible="state != 'obsolete'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Course title"/></h1>
                    </div>
                    <group>
                        <group name="identification" string="Identification">
                            <field name="code"/>
                            <field name="version"/>
                            <field name="course_type"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group name="delivery" string="Delivery">
                            <field name="delivery_mode"/>
                            <field name="elearning_url" widget="url"
                                   invisible="delivery_mode != 'external_elearning'"
                                   required="delivery_mode == 'external_elearning'"/>
                            <field name="duration_hours"
                                   widget="float_time"/>
                            <field name="validity_months"/>
                        </group>
                        <group name="assessment" string="Assessment">
                            <field name="requires_assessment"/>
                            <field name="pass_score"
                                   invisible="not requires_assessment"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="content" string="Content">
                            <field name="objective"
                                   placeholder="Learning objectives"/>
                            <field name="description"
                                   placeholder="Course content"/>
                        </page>
                        <page name="competencies" string="Competencies">
                            <field name="competency_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </page>
                        <page name="requirements"
                              string="Training Requirements">
                            <field name="requirement_ids" readonly="1">
                                <list>
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                    <field name="employee_id"/>
                                    <field name="mandatory"/>
                                    <field name="target_employee_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ls_training_course_search_view" model="ir.ui.view">
        <field name="name">ls.training.course.search</field>
        <field name="model">ls.training.course</field>
        <field name="arch" type="xml">
            <search string="Training Courses">
                <field name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                       string="Course"/>
                <field name="course_type"/>
                <field name="competency_ids"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_review" string="Under Review"
                        domain="[('state', '=', 'review')]"/>
                <separator/>
                <filter name="filter_expiring_courses"
                        string="With Expiring Certification"
                        domain="[('validity_months', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                                    <filter name="group_by_state" string="Status"
                        context="{'group_by': 'state'}"/>
                    <filter name="group_by_type" string="Course Type"
                        context="{'group_by': 'course_type'}"/>
                    <filter name="group_by_delivery" string="Delivery Mode"
                        context="{'group_by': 'delivery_mode'}"/>
            </search>
        </field>
    </record>

    <record id="ls_training_course_action" model="ir.actions.act_window">
        <field name="name">Training Courses</field>
        <field name="res_model">ls.training.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="ls_training_course_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first training course
            </p>
            <p>
                A course describes the training material, its duration, the
                competencies it grants and how long a resulting
                certification stays valid. Only approved courses can be
                scheduled into sessions.
            </p>
        </field>
    </record>

</odoo>
