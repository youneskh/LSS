<odoo>
    <data noupdate="1">

        <record id="ls_training_certification_expiry_mail_template"
                model="mail.template">
            <field name="name">Training: Certification Expiry Reminder</field>
            <field name="model_id"
                   ref="model_ls_training_certification"/>
            <field name="subject">Training certification {{ object.course_id.name }} - action required</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="lang">{{ object.employee_id.user_id.lang or object.company_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:13px;">
                    <p>Dear <t t-out="object.employee_id.name or ''">Employee</t>,</p>
                    <p>
                        Your training certification
                        <strong><t t-out="object.course_id.name or ''">Course</t></strong>
                        (reference <t t-out="object.name or ''">REF</t>)
                        <t t-if="object.state == 'expired'">
                            expired on
                        </t>
                        <t t-else="">
                            expires on
                        </t>
                        <strong><t t-out="object.date_expiry or ''">Date</t></strong>.
                    </p>
                    <p>
                        Please contact your training coordinator to schedule
                        the refresher session required to maintain your
                        qualification.
                    </p>
                    <p>
                        Regards,<br/>
                        <t t-out="object.company_id.name or ''">Company</t>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
