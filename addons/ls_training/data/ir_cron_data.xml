<odoo>
    <data noupdate="1">

        <record id="ls_training_cron_refresh_certification_state"
                model="ir.cron">
            <field name="name">Training: Refresh Certification Status</field>
            <field name="model_id"
                   ref="model_ls_training_certification"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_certification_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ls_training_cron_send_expiry_reminders" model="ir.cron">
            <field name="name">Training: Send Expiry Reminders</field>
            <field name="model_id"
                   ref="model_ls_training_certification"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_expiry_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
