<odoo>

    <record id="purchase_order_view_form_ls_supplier" model="ir.ui.view">
        <field name="name">purchase.order.form.ls.supplier.qualification</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="ls_qualification_warning" invisible="1"
                       groups="ls_supplier_qualification.group_ls_supplier_viewer"/>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not ls_qualification_warning"
                     groups="ls_supplier_qualification.group_ls_supplier_viewer">
                    <strong>Supplier qualification:</strong>
                    <field name="ls_qualification_warning" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
