<odoo>

    <record id="ls_supplier_approve_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.supplier.approve.wizard.form</field>
        <field name="model">ls.supplier.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Supplier Qualification">
                <div class="alert alert-warning" role="alert"
                     invisible="not blocking_reasons">
                    <strong>Outstanding prerequisites:</strong>
                    <field name="blocking_reasons" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <group string="Dossier">
                        <field name="qualification_id"/>
                        <field name="partner_id"/>
                        <field name="latest_assessment_score"/>
                        <field name="open_critical_finding_count"/>
                    </group>
                    <group string="Decision">
                        <field name="decision" widget="radio"/>
                        <field name="requalification_interval_months"/>
                        <field name="expiry_date"/>
                    </group>
                </group>
                <group string="Conditions" invisible="decision != 'conditional'">
                    <field name="conditions" nolabel="1"
                           required="decision == 'conditional'"
                           placeholder="Conditions the supplier must satisfy and the date by which they must be satisfied."/>
                </group>
                <group string="Justification">
                    <field name="reason" nolabel="1"
                           placeholder="Basis of the approval decision. Recorded verbatim in the signature log."/>
                </group>
                <group string="Signature">
                    <field name="signature_login"
                           placeholder="Retype your login"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Confirming records an entry in the append-only signature
                    log with your user, the current timestamp, the meaning of
                    the signature and the justification above. This confirms
                    intent; it does not re-authenticate you. See the
                    administrator manual for the procedural controls that
                    complete it.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Approval"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
