    <!-- ============================================================== -->
    <!-- Ownership rules on assessments                                 -->
    <!--                                                                 -->
    <!-- Rules attached to different groups are combined with OR, so a   -->
    <!-- Supplier Manager (who also holds the Assessor group by          -->
    <!-- implication) keeps unrestricted access through the manager      -->
    <!-- rule below.                                                     -->
    <!-- ============================================================== -->

    <record id="ls_supplier_assessment_rule_assessor" model="ir.rule">
        <field name="name">Assessment: assessors modify their own assessments</field>
        <field name="model_id" ref="model_ls_supplier_assessment"/>
        <field name="groups" eval="[(4, ref('group_ls_supplier_assessor'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('assessor_id', '=', user.id)]</field>
    </record>

    <record id="ls_supplier_assessment_rule_manager" model="ir.rule">
        <field name="name">Assessment: managers access all assessments</field>
        <field name="model_id" ref="model_ls_supplier_assessment"/>
        <field name="groups" eval="[(4, ref('group_ls_supplier_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="ls_supplier_audit_rule_auditor" model="ir.rule">
        <field name="name">Audit: assessors modify audits of their team</field>
        <field name="model_id" ref="model_ls_supplier_audit"/>
        <field name="groups" eval="[(4, ref('group_ls_supplier_assessor'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('lead_auditor_id', '=', user.id), ('auditor_ids', 'in', [user.id])]</field>
    </record>

    <record id="ls_supplier_audit_rule_manager" model="ir.rule">
        <field name="name">Audit: managers access all audits</field>
        <field name="model_id" ref="model_ls_supplier_audit"/>
        <field name="groups" eval="[(4, ref('group_ls_supplier_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
