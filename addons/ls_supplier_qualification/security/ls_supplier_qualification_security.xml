<odoo noupdate="1">

    <!-- ==============================================================
         Multi-company rules.

         No `groups` field is set: in Odoo a rule without groups is global
         and applies to every user, including administrators. The `global`
         field itself is computed from `groups` and is never written here.
         ============================================================== -->

    <record id="ls_supplier_category_rule_company" model="ir.rule">
        <field name="name">Supplier category: multi-company</field>
        <field name="model_id" ref="model_ls_supplier_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_supplier_criterion_rule_company" model="ir.rule">
        <field name="name">Supplier criterion: multi-company</field>
        <field name="model_id" ref="model_ls_supplier_criterion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_supplier_assessment_template_rule_company" model="ir.rule">
        <field name="name">Assessment template: multi-company</field>
        <field name="model_id" ref="model_ls_supplier_assessment_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
