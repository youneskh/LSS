     Starter criteria library.

     The wording below is ORIGINAL to this module. It does not quote,
     paraphrase or summarise the text of any standard or regulation. The
     `standard_ids` links express the association the organisation chooses to
     make between one of its own questions and a framework it applies; they
     are a traceability aid, not a statement about the content of that
     framework. Weights and mandatory flags are proposals to be reviewed and
     approved by the quality department.
-->
<odoo noupdate="1">

    <record id="criterion_qms_certified" model="ls.supplier.criterion">
        <field name="name">Certified quality management system in force</field>
        <field name="code">QMS-01</field>
        <field name="domain">qms</field>
        <field name="default_weight">3.0</field>
        <field name="is_mandatory" eval="True"/>
        <field name="description">Ask for the certificate, check its validity dates, its scope and the accreditation of the certification body.</field>
        <field name="standard_ids" eval="[(6, 0, [ref('standard_iso_9001'), ref('standard_iso_13485')])]"/>
        <field name="sequence">10</field>
    </record>

    <record id="criterion_qms_manual" model="ls.supplier.criterion">
        <field name="name">Documented quality manual and procedures available</field>
        <field name="code">QMS-02</field>
        <field name="domain">qms</field>
        <field name="default_weight">2.0</field>
        <field name="sequence">20</field>
    </record>

    <record id="criterion_qms_management_review" model="ls.supplier.criterion">
