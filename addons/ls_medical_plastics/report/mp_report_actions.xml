<odoo>

    <record id="action_report_mp_molding_run" model="ir.actions.report">
        <field name="name">Moulding Run Record</field>
        <field name="model">ls.mp.injection_molding</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_medical_plastics.report_mp_molding_run</field>
        <field name="report_file">ls_medical_plastics.report_mp_molding_run</field>
        <field name="binding_model_id" ref="model_ls_mp_injection_molding"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Moulding Run - %s' % (object.name)</field>
    </record>

    <record id="action_report_mp_tool_logbook" model="ir.actions.report">
        <field name="name">Tool Logbook</field>
        <field name="model">ls.mp.tool</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_medical_plastics.report_mp_tool_logbook</field>
        <field name="report_file">ls_medical_plastics.report_mp_tool_logbook</field>
        <field name="binding_model_id" ref="model_ls_mp_tool"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Tool Logbook - %s' % (object.code)</field>
    </record>

</odoo>
