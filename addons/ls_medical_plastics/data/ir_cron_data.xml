<odoo>
    <data noupdate="1">

        <!--
          Only field names whose stability in Odoo 19 could be established are
          used here. The optional ir.cron fields numbercall and doall are
          deliberately omitted because their presence in Odoo 19 could not be
          verified from official documentation; omitting them yields a
          recurring job with framework defaults.
        -->

        <record id="cron_mp_tool_status_check" model="ir.cron">
            <field name="name">Medical Plastics: check tool maintenance and requalification</field>
            <field name="model_id" ref="model_ls_mp_tool"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_tool_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_mp_specification_review_check" model="ir.cron">
            <field name="name">Medical Plastics: check moulding specification periodic review</field>
            <field name="model_id" ref="model_ls_mp_molding_parameter"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_specification_review()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
