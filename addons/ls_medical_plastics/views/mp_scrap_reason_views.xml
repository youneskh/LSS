<odoo>

    <record id="view_mp_scrap_reason_list" model="ir.ui.view">
        <field name="name">ls.mp.scrap.reason.list</field>
        <field name="model">ls.mp.scrap.reason</field>
        <field name="arch" type="xml">
            <list string="Scrap Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="is_startup"/>
                <field name="requires_investigation"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mp_scrap_reason_form" model="ir.ui.view">
        <field name="name">ls.mp.scrap.reason.form</field>
        <field name="model">ls.mp.scrap.reason</field>
        <field name="arch" type="xml">
            <form string="Scrap Reason">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_startup"/>
                            <field name="requires_investigation"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mp_scrap_reason_search" model="ir.ui.view">
        <field name="name">ls.mp.scrap.reason.search</field>
        <field name="model">ls.mp.scrap.reason</field>
        <field name="arch" type="xml">
            <search string="Scrap Reasons">
                <field name="name" string="Reason"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <filter name="filter_startup" string="Start-up Scrap" domain="[('is_startup', '=', True)]"/>
                <filter name="filter_investigation" string="Requires Investigation"
                        domain="[('requires_investigation', '=', True)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mp_scrap_reason" model="ir.actions.act_window">
        <field name="name">Scrap Reasons</field>
        <field name="res_model">ls.mp.scrap.reason</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mp_scrap_reason_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a scrap reason</p>
            <p>Scrap reasons classify rejected parts. Reasons flagged as start-up scrap
               are excluded from the quality reject rate of a moulding run.</p>
        </field>
    </record>

</odoo>
