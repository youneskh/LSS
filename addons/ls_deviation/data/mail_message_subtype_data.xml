<odoo>
    <data noupdate="1">
        <record id="mt_deviation_closed" model="mail.message.subtype">
            <field name="name">Deviation Closed</field>
            <field name="res_model">ls.deviation</field>
            <field name="default" eval="True"/>
            <field name="description">A deviation has been closed.</field>
        </record>
        <record id="mt_deviation_cancelled" model="mail.message.subtype">
            <field name="name">Deviation Cancelled</field>
            <field name="res_model">ls.deviation</field>
            <field name="default" eval="True"/>
            <field name="description">A deviation has been cancelled.</field>
        </record>
    </data>
</odoo>
