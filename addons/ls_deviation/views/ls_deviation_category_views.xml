<odoo>
    <record id="view_ls_deviation_category_list" model="ir.ui.view">
        <field name="name">ls.deviation.category.list</field>
        <field name="model">ls.deviation.category</field>
        <field name="arch" type="xml">
            <list string="Deviation Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="deviation_count" string="Deviations"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_deviation_category_form" model="ir.ui.view">
        <field name="name">ls.deviation.category.form</field>
        <field name="model">ls.deviation.category</field>
        <field name="arch" type="xml">
            <form string="Deviation Category">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Category name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="deviation_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ls_deviation_category" model="ir.actions.act_window">
        <field name="name">Deviation Categories</field>
        <field name="res_model">ls.deviation.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
