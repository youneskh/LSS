<odoo>
    <record id="view_ls_deviation_action_form" model="ir.ui.view">
        <field name="name">ls.deviation.action.form</field>
        <field name="model">ls.deviation.action</field>
        <field name="arch" type="xml">
            <form string="Immediate Action">
                <sheet>
                    <group>
                        <group>
                            <field name="deviation_id"/>
                            <field name="name"/>
                            <field name="action_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="deadline"/>
                            <field name="date_done"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" nolabel="1"/>
                    <separator string="Completion Evidence"/>
                    <field name="completion_evidence" nolabel="1"
                           required="state == 'done'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_deviation_action_list" model="ir.ui.view">
        <field name="name">ls.deviation.action.list</field>
        <field name="model">ls.deviation.action</field>
        <field name="arch" type="xml">
            <list string="Immediate Actions" decoration-muted="state == 'cancelled'">
                <field name="deviation_id"/>
                <field name="name"/>
                <field name="action_type"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="deadline"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="action_ls_deviation_action" model="ir.actions.act_window">
        <field name="name">Immediate Actions</field>
        <field name="res_model">ls.deviation.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
