<odoo>

    <record id="seq_ls_audit_trail_evidence_pack" model="ir.sequence">
        <field name="name">Audit Trail Evidence Pack</field>
        <field name="code">ls.audit_trail.evidence_pack</field>
        <field name="prefix">EVP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_verification_window" model="ir.config_parameter">
        <field name="key">ls_audit_trail.verification_window_days</field>
        <field name="value">7</field>
    </record>

    <!--
        Only the ir.cron fields whose presence in Odoo 19 is established are
        written here. The fields that counted remaining calls on older releases
        are deliberately not set, so that this data file does not depend on
        their existence.
    -->
    <record id="cron_verify_chain" model="ir.cron">
        <field name="name">Audit Trail: Verify Integrity</field>
        <field name="model_id" ref="model_ls_audit_trail_log"/>
        <field name="state">code</field>
        <field name="code">model._ls_cron_verify_chain()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
    </record>

</odoo>
