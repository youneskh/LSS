<odoo>

    <record id="view_company_form_ls_audit_trail" model="ir.ui.view">
        <field name="name">res.company.form.ls.audit.trail</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Audit Trail Retention" name="ls_audit_trail">
                    <field name="ls_audit_entry_count" readonly="1"/>
                    <field name="ls_audit_retention_days"/>
                    <field name="ls_audit_retention_procedure"/>
                    <field name="ls_audit_allow_purge"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not ls_audit_allow_purge">
                        Retention runs are enabled for this company. Audit
                        entries older than the retention period can be removed
                        by an audit administrator. Each run records a retention
                        anchor that keeps the chain verifiable.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
