<odoo>

    <record id="view_ls_audit_trail_rule_list" model="ir.ui.view">
        <field name="name">ls.audit_trail.rule.list</field>
        <field name="model">ls.audit_trail.rule</field>
        <field name="arch" type="xml">
            <list string="Audit Rules">
                <field name="name"/>
                <field name="model_name"/>
                <field name="log_create" widget="boolean_toggle"/>
                <field name="log_write" widget="boolean_toggle"/>
                <field name="log_unlink" widget="boolean_toggle"/>
                <field name="entry_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ls_audit_trail_rule_form" model="ir.ui.view">
        <field name="name">ls.audit_trail.rule.form</field>
        <field name="model">ls.audit_trail.rule</field>
        <field name="arch" type="xml">
            <form string="Audit Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="entry_count" widget="statinfo"
                                   string="Entries"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Manufacturing order release"/></h1>
                    </div>
                    <group>
                        <group string="Scope" name="scope">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Audited Operations" name="operations">
                            <field name="log_create"/>
                            <field name="log_write"/>
                            <field name="log_unlink"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <group>
                                <field name="field_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       readonly="not model_id"/>
                                <field name="excluded_field_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       readonly="not model_id"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Leaving <strong>Audited Fields</strong> empty audits every
                                stored field of the model except id, create_uid,
                                create_date, write_uid, write_date and display_name.
                                One-to-many and many-to-many fields are never captured
                                directly; audit the model on the other side of the
                                relation instead.
                            </div>
                        </page>
                        <page string="Justification" name="justification">
                            <field name="note" nolabel="1"
                                   placeholder="Why this scope was chosen, and which procedure requires it."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ls_audit_trail_rule_search" model="ir.ui.view">
        <field name="name">ls.audit_trail.rule.search</field>
        <field name="model">ls.audit_trail.rule</field>
        <field name="arch" type="xml">
            <search string="Audit Rules">
                <field name="name"/>
                <field name="model_name"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <filter name="filter_audits_deletions" string="Audits Deletions"
                        domain="[('log_unlink', '=', True)]"/>
                                    <filter name="group_rule_company" string="Company"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_audit_trail_rule" model="ir.actions.act_window">
        <field name="name">Audit Rules</field>
        <field name="res_model">ls.audit_trail.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_audit_trail_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first audit rule</p>
            <p>
                Nothing is audited until a rule says so. Each rule names one
                model, the operations to capture and, optionally, the exact
                fields to capture. Keep the scope narrow and justified: every
                captured field adds volume to the trail.
            </p>
        </field>
    </record>

</odoo>
