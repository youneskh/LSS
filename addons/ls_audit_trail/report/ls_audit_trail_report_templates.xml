<odoo>

    <template id="report_evidence_pack_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>
                    Audit Trail Evidence Pack
                    <span t-field="doc.name"/>
                </h2>
                <p class="text-muted">
                    This cover sheet describes a sealed export of audit trail
                    entries. It does not replace the archive: the archive
                    contains the entries themselves, together with a manifest
                    stating the digest of each exported file.
                </p>

                <h4>Identification</h4>
                <table class="table table-sm">
                    <tr>
                        <td><strong>Reference</strong></td>
                        <td><span t-field="doc.name"/></td>
                        <td><strong>Company</strong></td>
                        <td><span t-field="doc.company_id"/></td>
                    </tr>
                    <tr>
                        <td><strong>Generated on (UTC)</strong></td>
                        <td><span t-field="doc.generated_on"/></td>
                        <td><strong>Generated by</strong></td>
                        <td><span t-field="doc.generated_by"/></td>
                    </tr>
                    <tr>
                        <td><strong>Status</strong></td>
                        <td><span t-field="doc.state"/></td>
                        <td><strong>Archive digest (SHA-256)</strong></td>
                        <td><span t-field="doc.pack_digest"/></td>
                    </tr>
                </table>

                <h4>Selection Criteria</h4>
                <table class="table table-sm">
                    <tr>
                        <td><strong>Event date from</strong></td>
                        <td><span t-field="doc.date_from"/></td>
                        <td><strong>Event date to</strong></td>
                        <td><span t-field="doc.date_to"/></td>
                    </tr>
                    <tr>
                        <td><strong>Model filter</strong></td>
                        <td>
                            <span t-if="doc.model_names" t-field="doc.model_names"/>
                            <span t-if="not doc.model_names">Every audited model</span>
                        </td>
                        <td><strong>User filter</strong></td>
                        <td>
                            <t t-if="doc.user_ids">
                                <span t-esc="', '.join(doc.user_ids.mapped('login'))"/>
                            </t>
                            <span t-if="not doc.user_ids">Every user</span>
                        </td>
                    </tr>
                </table>

                <h4>Content</h4>
                <table class="table table-sm">
                    <tr>
                        <td><strong>Entries exported</strong></td>
                        <td><span t-field="doc.entry_count"/></td>
                        <td><strong>Field changes exported</strong></td>
                        <td><span t-field="doc.line_count"/></td>
                    </tr>
                    <tr>
                        <td><strong>First chain position</strong></td>
                        <td><span t-field="doc.first_sequence"/></td>
                        <td><strong>Last chain position</strong></td>
                        <td><span t-field="doc.last_sequence"/></td>
                    </tr>
                </table>

                <h4>Integrity Verification</h4>
                <t t-if="doc.verification_id">
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Verification reference</strong></td>
                            <td><span t-field="doc.verification_id.name"/></td>
                            <td><strong>Result</strong></td>
                            <td><span t-field="doc.verification_id.result"/></td>
                        </tr>
                        <tr>
                            <td><strong>Entries verified</strong></td>
                            <td><span t-field="doc.verification_id.entries_checked"/></td>
                            <td><strong>Executed on (UTC)</strong></td>
                            <td><span t-field="doc.verification_id.executed_on"/></td>
                        </tr>
                    </table>
                    <p><strong>Findings</strong></p>
                    <p style="white-space: pre-wrap;"
                       t-field="doc.verification_id.details"/>
                </t>
                <t t-if="not doc.verification_id">
                    <p>No integrity verification is attached to this pack.</p>
                </t>

                <h4>Purpose</h4>
                <p style="white-space: pre-wrap;" t-field="doc.purpose"/>

                <h4>Review</h4>
                <table class="table table-sm">
                    <tr>
                        <td style="width: 50%;"><strong>Reviewed by</strong><br/><br/><br/></td>
                        <td style="width: 50%;"><strong>Date</strong><br/><br/><br/></td>
                    </tr>
                </table>
                <p class="text-muted">
                    Signatures collected on this printed sheet are handwritten
                    signatures on paper. This module implements no electronic
                    signature; see the module documentation for the boundary
                    between this module and electronic signature functionality.
                </p>
            </div>
        </t>
    </template>

    <template id="report_evidence_pack">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ls_audit_trail.report_evidence_pack_document"/>
            </t>
        </t>
    </template>

    <template id="report_verification_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>
                    Audit Trail Integrity Verification
                    <span t-field="doc.name"/>
                </h2>

                <table class="table table-sm">
                    <tr>
                        <td><strong>Company</strong></td>
                        <td><span t-field="doc.company_id"/></td>
                        <td><strong>Result</strong></td>
                        <td><span t-field="doc.result"/></td>
                    </tr>
                    <tr>
                        <td><strong>Executed on (UTC)</strong></td>
                        <td><span t-field="doc.executed_on"/></td>
                        <td><strong>Executed by</strong></td>
                        <td><span t-field="doc.executed_by"/></td>
                    </tr>
                    <tr>
                        <td><strong>Source</strong></td>
                        <td><span t-field="doc.source"/></td>
                        <td><strong>Entries verified</strong></td>
                        <td><span t-field="doc.entries_checked"/></td>
                    </tr>
                    <tr>
                        <td><strong>Range from</strong></td>
                        <td><span t-field="doc.date_from"/></td>
                        <td><strong>Range to</strong></td>
                        <td><span t-field="doc.date_to"/></td>
                    </tr>
                </table>

                <t t-if="doc.result == 'failed'">
                    <h4>Divergence</h4>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>First divergent chain position</strong></td>
                            <td><span t-field="doc.first_failure_sequence"/></td>
                        </tr>
                    </table>
                </t>

                <h4>Findings</h4>
                <p style="white-space: pre-wrap;" t-field="doc.details"/>

                <h4>Method</h4>
                <p>
                    For every entry in the verified range, the canonical payload
                    was rebuilt from the stored values and its SHA-256 digest
                    recomputed, then the chain digest was recomputed from that
                    payload digest and from the recorded digest of the preceding
                    entry. Chain positions were checked for continuity. When the
                    verified range starts at the head of the chain, the head was
                    additionally reconciled against the retention anchors.
                </p>
            </div>
        </t>
    </template>

    <template id="report_verification">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ls_audit_trail.report_verification_document"/>
            </t>
        </t>
    </template>

</odoo>
