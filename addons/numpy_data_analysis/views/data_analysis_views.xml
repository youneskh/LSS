<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_data_analysis_list" model="ir.ui.view">
            <field name="name">data.analysis.list</field>
            <field name="model">data.analysis</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="mean_value"/>
                    <field name="std_dev"/>
                    <field name="min_value"/>
                    <field name="max_value"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_data_analysis_form" model="ir.ui.view">
            <field name="name">data.analysis.form</field>
            <field name="model">data.analysis</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <group string="Input Data">
                            <field name="data_values" placeholder="e.g. 10, 20, 30, 40, 50"/>
                        </group>
                        <group string="Statistical Analysis (Numpy)">
                            <field name="mean_value" readonly="1"/>
                            <field name="std_dev" readonly="1"/>
                            <field name="min_value" readonly="1"/>
                            <field name="max_value" readonly="1"/>
                            <field name="median_value" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_data_analysis" model="ir.actions.act_window">
            <field name="name">Data Analysis</field>
            <field name="res_model">data.analysis</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new data analysis record.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_data_analysis" name="Data Analysis" action="action_data_analysis" sequence="100"/>
    </data>
</odoo>
