<odoo>

    <record id="view_ls_risk_category_list" model="ir.ui.view">
        <field name="name">ls.risk.category.list</field>
        <field name="model">ls.risk.category</field>
        <field name="arch" type="xml">
            <list string="Risk Categories">
                <field name="complete_name" string="Category"/>
                <field name="code"/>
                <field name="risk_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_risk_category_form" model="ir.ui.view">
        <field name="name">ls.risk.category.form</field>
        <field name="model">ls.risk.category</field>
        <field name="arch" type="xml">
            <form string="Risk Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="complete_name"/>
                        </group>
                        <group>
                            <field name="risk_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <field name="child_ids" invisible="1"/>
                    <field name="parent_path" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_risk_category_search" model="ir.ui.view">
        <field name="name">ls.risk.category.search</field>
        <field name="model">ls.risk.category</field>
        <field name="arch" type="xml">
            <search string="Search Risk Categories">
                <field name="complete_name" string="Category"/>
                <field name="code"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                                    <filter name="group_parent" string="Parent Category"
                        context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_risk_category" model="ir.actions.act_window">
        <field name="name">Risk Categories</field>
        <field name="res_model">ls.risk.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_risk_category_search"/>
    </record>

</odoo>
