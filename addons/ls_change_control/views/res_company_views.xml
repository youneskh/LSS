     The module ships its own configuration form instead of extending the
     standard company or settings views. Nothing of the standard Odoo layout
     is modified, which removes any upgrade risk on those views. -->
<odoo>

    <record id="view_ls_change_control_company_form" model="ir.ui.view">
        <field name="name">res.company.form.ls.change.control</field>
        <field name="model">res.company</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form string="Change Control Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Approvals">
                            <field name="ls_cc_approval_reminder_days"/>
                        </group>
                        <group string="Effectiveness Verification">
                            <field name="ls_cc_require_verification"/>
                            <field name="ls_cc_default_verification_delay"/>
                        </group>
                        <group string="Implementation">
                            <field name="ls_cc_block_close_on_open_actions"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        These parameters apply to the change requests of this
                        company only. In a multi-site organisation each site
                        keeps its own change control parameters.
                    </div>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ls_change_control_settings" model="ir.actions.act_window">
        <field name="name">Change Control Settings</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ls_change_control_company_form"/>
        <field name="target">new</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

</odoo>
