<odoo>
    <data noupdate="1">

        <record id="seq_ls_complaint" model="ir.sequence">
            <field name="name">Complaint</field>
            <field name="code">ls.complaint</field>
            <field name="prefix">CMP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ls_complaint_investigation" model="ir.sequence">
            <field name="name">Complaint Investigation</field>
            <field name="code">ls.complaint.investigation</field>
            <field name="prefix">CMP/INV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ls_complaint_adverse_event" model="ir.sequence">
            <field name="name">Complaint Adverse Event</field>
            <field name="code">ls.complaint.adverse_event</field>
            <field name="prefix">CMP/AE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
