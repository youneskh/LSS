<odoo>

    <record id="ls_complaint_close_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.complaint.close.wizard.form</field>
        <field name="model">ls.complaint.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Complaint">
                <group>
                    <field name="complaint_id" readonly="1"/>
                    <field name="complaint_state" readonly="1"/>
                    <field name="owner_id" readonly="1"/>
                    <field name="reviewer_id"/>
                    <field name="effectiveness_confirmed"/>
                    <field name="customer_notified"/>
                </group>
                <label for="closure_summary"/>
                <field name="closure_summary"
                       placeholder="Summary of the outcome, of the actions taken and of their verification"/>
                <footer>
                    <button name="action_confirm" type="object" string="Close Complaint"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
