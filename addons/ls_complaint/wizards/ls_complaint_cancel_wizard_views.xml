<odoo>

    <record id="ls_complaint_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.complaint.cancel.wizard.form</field>
        <field name="model">ls.complaint.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Complaint">
                <group>
                    <field name="complaint_id" readonly="1"/>
                </group>
                <label for="reason"/>
                <field name="reason"
                       placeholder="Documented justification of the cancellation"/>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Complaint"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
