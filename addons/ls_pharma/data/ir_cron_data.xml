     Scheduled actions.

     Only fields whose presence in Odoo 19 is relied upon elsewhere in this
     module are set. Fields governing the number of remaining calls and the
     catch-up behaviour are deliberately not set, so that the records do not
     depend on the exact field names of the scheduler in this version. -->
<odoo>
    <data noupdate="1">

        <record id="cron_ls_pharma_stability_overdue" model="ir.cron">
            <field name="name">Pharmaceutical: flag overdue stability time points</field>
            <field name="model_id" ref="model_ls_pharma_stability_study"/>
            <field name="state">code</field>
            <field name="code">model.cron_flag_overdue_timepoints()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_ls_pharma_batch_expiry" model="ir.cron">
            <field name="name">Pharmaceutical: notify batches approaching expiry</field>
            <field name="model_id" ref="model_ls_pharma_batch"/>
            <field name="state">code</field>
            <field name="code">model.cron_notify_expiring_batches()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
