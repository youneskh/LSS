<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ls_lab_sample_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.lab.sample_cancel_wizard.form</field>
        <field name="model">ls.lab.sample_cancel_wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Sample">
                <group>
                    <field name="sample_id"/>
                    <field name="sample_state"/>
                </group>
                <group string="Cancellation Reason">
                    <field name="reason" nolabel="1"
                           placeholder="Explain why this sample is being cancelled"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Cancelling a sample is recorded permanently together with your user
                    name and this reason. The sample and its results are retained.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Sample"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ls_lab_stability_pull_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.lab.stability_pull_wizard.form</field>
        <field name="model">ls.lab.stability_pull_wizard</field>
        <field name="arch" type="xml">
            <form string="Create Stability Pull Sample">
                <group>
                    <group string="Time Point">
                        <field name="timepoint_id"/>
                        <field name="study_id"/>
                        <field name="product_id"/>
                        <field name="scheduled_date"/>
                        <field name="pull_date"/>
                    </group>
                    <group string="Sample">
                        <field name="specification_id" options="{'no_create': True}"/>
                        <field name="storage_condition_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="due_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create Sample"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ls_lab_signature_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.lab.signature_wizard.form</field>
        <field name="model">ls.lab.signature_wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Signature Intent">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="record_label"/>
                    <field name="meaning"/>
                </group>
                <group>
                    <field name="acknowledged"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    <field name="limitation_notice" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
