<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ls_lab_storage_condition_view_list" model="ir.ui.view">
        <field name="name">ls.lab.storage_condition.list</field>
        <field name="model">ls.lab.storage_condition</field>
        <field name="arch" type="xml">
            <list default_order="sequence, code">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="temperature_c"/>
                <field name="temperature_tolerance_c" optional="hide"/>
                <field name="humidity_rh"/>
                <field name="humidity_tolerance_rh" optional="hide"/>
                <field name="light_condition"/>
                <field name="reference" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ls_lab_storage_condition_view_form" model="ir.ui.view">
        <field name="name">ls.lab.storage_condition.form</field>
        <field name="model">ls.lab.storage_condition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Long term storage"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Conditions">
                            <field name="temperature_c"/>
                            <field name="temperature_tolerance_c"/>
                            <field name="humidity_rh"/>
                            <field name="humidity_tolerance_rh"/>
                            <field name="light_condition"/>
                        </group>
                    </group>
                    <group string="Reference">
                        <field name="reference" nolabel="1"
                               placeholder="Internal procedure or guideline reference"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Storage conditions are configuration data. This module ships no
                        guideline values; the conditions recorded here are defined by your
                        organisation against the guideline version applicable to it.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ls_lab_storage_condition_view_search" model="ir.ui.view">
        <field name="name">ls.lab.storage_condition.search</field>
        <field name="model">ls.lab.storage_condition</field>
        <field name="arch" type="xml">
            <search string="Storage Conditions">
                <field name="code"/>
                <field name="name"/>
                <field name="reference"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_light_condition" string="Light Condition"
                            domain="[]" context="{'group_by': 'light_condition'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ls_lab_action_storage_condition" model="ir.actions.act_window">
        <field name="name">Storage Conditions</field>
        <field name="res_model">ls.lab.storage_condition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your first storage condition</p>
            <p>
                Storage conditions describe the temperature, humidity and light
                environment used for samples and stability studies. They are
                configuration data owned by your organisation.
            </p>
        </field>
    </record>

</odoo>
