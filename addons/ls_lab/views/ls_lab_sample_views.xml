<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ls_lab_sample_view_list" model="ir.ui.view">
        <field name="name">ls.lab.sample.list</field>
        <field name="model">ls.lab.sample</field>
        <field name="arch" type="xml">
            <list decoration-danger="overall_result == 'non_conform'"
                  decoration-success="overall_result == 'conform'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="sample_type"/>
                <field name="specification_id" optional="hide"/>
                <field name="received_date"/>
                <field name="due_date" optional="show"/>
                <field name="result_count" optional="hide"/>
                <field name="pending_result_count" optional="hide"/>
                <field name="overall_result" widget="badge"
                       decoration-success="overall_result == 'conform'"
                       decoration-danger="overall_result == 'non_conform'"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('approved', 'reported')"
                       decoration-info="state in ('testing', 'results_recorded')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ls_lab_sample_view_kanban" model="ir.ui.view">
        <field name="name">ls.lab.sample.kanban</field>
        <field name="model">ls.lab.sample</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="product_id"/>
                <field name="overall_result"/>
                <field name="due_date"/>
                <field name="sample_type"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="o_kanban_record_subtitle">
                                    <field name="product_id"/>
                                </span>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <span><field name="sample_type"/></span>
                            <br/>
                            <span t-if="record.due_date.raw_value">
                                Due: <field name="due_date"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="overall_result" widget="badge"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ls_lab_sample_view_form" model="ir.ui.view">
        <field name="name">ls.lab.sample.form</field>
        <field name="model">ls.lab.sample</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="oe_highlight" invisible="state != 'received'"
                            groups="ls_lab.ls_lab_group_analyst"/>
                    <button name="action_start_testing" type="object"
                            string="Start Testing" class="oe_highlight"
                            invisible="state != 'in_progress'"
                            groups="ls_lab.ls_lab_group_analyst"/>
                    <button name="action_record_results" type="object"
                            string="Confirm Results Recorded" class="oe_highlight"
                            invisible="state != 'testing'"
                            groups="ls_lab.ls_lab_group_analyst"/>
                    <button name="action_review" type="object" string="Review"
                            class="oe_highlight" invisible="state != 'results_recorded'"
                            groups="ls_lab.ls_lab_group_reviewer"/>
                    <button name="action_open_approval_signature" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="state != 'reviewed'"
                            groups="ls_lab.ls_lab_group_manager"/>
                    <button name="action_report" type="object" string="Mark Reported"
                            invisible="state != 'approved'"
                            groups="ls_lab.ls_lab_group_manager"/>
                    <button name="action_open_cancel_wizard" type="object"
                            string="Cancel"
                            invisible="state in ('approved', 'reported', 'cancelled')"
                            groups="ls_lab.ls_lab_group_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,in_progress,testing,results_recorded,reviewed,approved,reported"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_results" type="object"
                                class="oe_stat_button" icon="fa-flask">
                            <field name="result_count" widget="statinfo" string="Results"/>
                        </button>
                        <button name="action_view_oos" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="open_oos_count == 0">
                            <field name="open_oos_count" widget="statinfo"
                                   string="Open OOS"/>
                        </button>
                        <button name="action_view_coa" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="coa_count" widget="statinfo" string="Certificates"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="description" placeholder="Short description"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Material">
                            <field name="product_id"
                                   readonly="state not in ('received',)"/>
                            <field name="lot_id"
                                   readonly="state not in ('received',)"/>
                            <field name="batch_reference"/>
                            <field name="sample_type"
                                   readonly="state not in ('received',)"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Specification">
                            <field name="specification_id"
                                   readonly="state not in ('received',)"
                                   options="{'no_create': True}"/>
                            <field name="overall_result"/>
                            <field name="storage_condition_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Sampling and Receipt">
                            <field name="sampled_date"/>
                            <field name="sampled_by_id"/>
                            <field name="sampling_point"/>
                            <field name="received_date"/>
                            <field name="received_by_id"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Review and Approval">
                            <field name="reviewed_by_id"/>
                            <field name="review_date"/>
                            <field name="approved_by_id"/>
                            <field name="approval_date"/>
                            <field name="reported_by_id" invisible="not reported_by_id"/>
                            <field name="report_date" invisible="not report_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Test Results" name="results">
                            <field name="result_ids" readonly="1">
                                <list default_order="sequence, id"
                                      decoration-danger="evaluation == 'non_conform'"
                                      decoration-success="evaluation == 'conform'">
                                    <field name="sequence" optional="hide"/>
                                    <field name="test_method_id"/>
                                    <field name="criterion_display"/>
                                    <field name="result_display"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="evaluation" widget="badge"
                                           decoration-success="evaluation == 'conform'"
                                           decoration-danger="evaluation == 'non_conform'"/>
                                    <field name="is_oot" optional="show"/>
                                    <field name="analyst_id"/>
                                    <field name="reviewed_by_id" optional="show"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <div class="alert alert-warning" role="alert"
                                 invisible="open_oos_count == 0">
                                This sample has open investigations and cannot be
                                approved until they are closed.
                            </div>
                        </page>
                        <page string="Investigations" name="investigations"
                              invisible="not oos_ids">
                            <field name="oos_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="oos_type"/>
                                    <field name="test_method_id"/>
                                    <field name="investigator_id"/>
                                    <field name="final_conclusion"/>
                                    <field name="product_disposition"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stability" name="stability"
                              invisible="not stability_timepoint_id">
                            <group>
                                <field name="stability_timepoint_id"/>
                            </group>
                        </page>
                        <page string="Cancellation" name="cancellation"
                              invisible="state != 'cancelled'">
                            <group>
                                <field name="cancelled_by_id"/>
                                <field name="cancel_reason"/>
                            </group>
                        </page>
                        <page string="Signature Intent" name="signature"
                              invisible="not signature_user_id">
                            <group>
                                <field name="signature_user_id"/>
                                <field name="signature_date"/>
                                <field name="signature_meaning"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Signature intent records the signing user, the timestamp
                                and the declared meaning. It does not re-authenticate the
                                user and is not an FDA 21 CFR Part 11 electronic
                                signature.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ls_lab_sample_view_search" model="ir.ui.view">
        <field name="name">ls.lab.sample.search</field>
        <field name="model">ls.lab.sample</field>
        <field name="arch" type="xml">
            <search string="Samples">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="batch_reference"/>
                <field name="specification_id"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'not in', ('approved', 'reported', 'cancelled'))]"/>
                <filter name="filter_awaiting_review" string="Awaiting Review"
                        domain="[('state', '=', 'results_recorded')]"/>
                <filter name="filter_awaiting_approval" string="Awaiting Approval"
                        domain="[('state', '=', 'reviewed')]"/>
                <separator/>
                <filter name="filter_non_conform" string="Does Not Conform"
                        domain="[('overall_result', '=', 'non_conform')]"/>
                <filter name="filter_conform" string="Conforms"
                        domain="[('overall_result', '=', 'conform')]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('approved', 'reported', 'cancelled'))]"/>
                <filter name="filter_received_date" string="Receipt Date"
                        date="received_date"/>
                <separator/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_by_state" string="Status"
                            domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_by_sample_type" string="Sample Type"
                            domain="[]" context="{'group_by': 'sample_type'}"/>
                    <filter name="group_by_product" string="Product"
                            domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_overall_result" string="Overall Result"
                            domain="[]" context="{'group_by': 'overall_result'}"/>
                    <filter name="group_by_received_date" string="Receipt Date"
                            domain="[]" context="{'group_by': 'received_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ls_lab_action_sample" model="ir.actions.act_window">
        <field name="name">Sample Register</field>
        <field name="res_model">ls.lab.sample</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="ls_lab_sample_view_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first sample</p>
            <p>
                Registering a sample against an approved specification generates one
                result line per test, so the test list cannot be shortened during
                analysis.
            </p>
        </field>
    </record>

    <record id="ls_lab_action_sample_receipt" model="ir.actions.act_window">
        <field name="name">Sample Receipt</field>
        <field name="res_model">ls.lab.sample</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="ls_lab_sample_view_search"/>
        <field name="domain">[('state', '=', 'received')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sample awaiting handling</p>
            <p>Samples that have been received but not yet started appear here.</p>
        </field>
    </record>

    <record id="ls_lab_action_stability_sample" model="ir.actions.act_window">
        <field name="name">Stability Samples</field>
        <field name="res_model">ls.lab.sample</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="ls_lab_sample_view_search"/>
        <field name="domain">[('sample_type', '=', 'stability')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stability sample yet</p>
            <p>Samples pulled at stability study time points appear here.</p>
        </field>
    </record>

</odoo>
