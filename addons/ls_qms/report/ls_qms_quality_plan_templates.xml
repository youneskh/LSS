<odoo>

    <template id="report_ls_qms_quality_plan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center"><span t-field="doc.name"/></h2>
                        <t t-call="ls_qms.report_ls_qms_document_control_block"/>
                        <div t-if="doc.subject">
                            <h4>1. Subject</h4>
                            <p><span t-field="doc.subject"/></p>
                        </div>
                        <div t-if="doc.scope">
                            <h4>2. Scope</h4>
                            <p><span t-field="doc.scope"/></p>
                        </div>
                        <div t-if="doc.objective_summary">
                            <h4>3. Quality Objectives of the Plan</h4>
                            <p><span t-field="doc.objective_summary"/></p>
                        </div>
                        <h4>4. Control Plan</h4>
                        <table class="table table-sm table-bordered" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th>Stage</th>
                                    <th>Characteristic</th>
                                    <th>Specification</th>
                                    <th>Method</th>
                                    <th>Frequency</th>
                                    <th>Sample</th>
                                    <th>Responsible</th>
                                    <th>Record</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-field="line.stage"/></td>
                                    <td><span t-field="line.characteristic"/></td>
                                    <td><span t-field="line.specification"/></td>
                                    <td><span t-field="line.control_method"/></td>
                                    <td><span t-field="line.frequency"/></td>
                                    <td><span t-field="line.sample_size"/></td>
                                    <td><span t-field="line.responsible_id"/></td>
                                    <td><span t-field="line.record_reference"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="doc.sop_ids">
                            <h4>5. Applicable Procedures</h4>
                            <ul>
                                <li t-foreach="doc.sop_ids" t-as="sop">
                                    <span t-field="sop.reference"/> - <span t-field="sop.name"/>
                                </li>
                            </ul>
                        </div>
                        <t t-call="ls_qms.report_ls_qms_uncontrolled_copy_notice"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
