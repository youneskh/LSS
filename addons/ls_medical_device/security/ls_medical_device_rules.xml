<odoo>

    <!--
        All rules below are global: no group is attached to any of them.

        Reason: the name of the field holding the groups of an ir.rule record in
        Odoo 19.0 could not be verified from official documentation during
        preparation of this module. Writing an unverified field name into a data
        file would abort the installation. Global rules do not need that field.

        Consequence: the rules below implement multi-company scoping only.
        Differentiation between the four access levels of this module is
        implemented through ir.model.access records and through the authority
        checks performed in Python by the business methods of each model. That
        combination is stated in the Administrator Manual so that the design is
        not mistaken for an omission.

        The computed field ir.rule.global is never written here; it is derived
        by Odoo from the presence or absence of groups.
    -->

    <record id="rule_ls_md_device_company" model="ir.rule">
        <field name="name">Medical Device: multi-company</field>
        <field name="model_id" ref="model_ls_md_device"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

