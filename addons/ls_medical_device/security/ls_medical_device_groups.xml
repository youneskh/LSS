<odoo>

    <!--
        Odoo 19.0 replaced the module category reference on res.groups with a
        privilege record. The structure below follows the official Odoo 19.0
        developer tutorial "Restrict access to data", which creates a
        res.groups.privilege record and references it from each group through
        the privilege_id field.
    -->
    <record id="module_category_life_sciences_medical_device" model="ir.module.category">
        <field name="name">Medical Devices</field>
        <field name="description">Access levels for the Life Sciences Medical Devices application.</field>
        <field name="sequence">55</field>
    </record>

    <record id="privilege_ls_medical_device" model="res.groups.privilege">
        <field name="name">Medical Devices</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_life_sciences_medical_device"/>
    </record>

    <record id="group_ls_md_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_ls_medical_device"/>
        <field name="comment">Read-only access to the medical device register and its regulatory records.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ls_md_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_ls_medical_device"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_md_viewer'))]"/>
        <field name="comment">Create and maintain device records and their draft regulatory documentation. Cannot approve regulatory records or change the market status of a device.</field>
    </record>

    <record id="group_ls_md_regulatory" model="res.groups">
        <field name="name">Regulatory Affairs</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_ls_medical_device"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_md_user'))]"/>
        <field name="comment">Approve regulatory records, manage certificates and change the market status of a device.</field>
    </record>

    <record id="group_ls_md_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_ls_medical_device"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_md_regulatory'))]"/>
        <field name="comment">Full access, including configuration of risk classes, notified bodies and documentation templates.</field>
    </record>

</odoo>
