<odoo>

    <record id="ls_calibration_certificate_view_list" model="ir.ui.view">
        <field name="name">ls.calibration.certificate.list</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="arch" type="xml">
            <list string="Calibration Certificates">
                <field name="name" />
                <field name="instrument_id" />
                <field name="record_id" optional="show" />
                <field name="issuer_type" />
                <field name="issuer_partner_id" optional="show" />
                <field name="accreditation_reference" optional="hide" />
                <field name="issue_date" />
                <field name="valid_until" optional="show" />
                <field name="state" widget="badge" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="ls_calibration_certificate_view_form" model="ir.ui.view">
        <field name="name">ls.calibration.certificate.form</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="arch" type="xml">
            <form string="Calibration Certificate">
                <header>
                    <button
                        name="action_issue"
                        string="Issue"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_supersede"
                        string="Supersede"
                        type="object"
                        invisible="state != 'issued'"
                        groups="ls_calibration.group_ls_calibration_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,issued,superseded"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="state != 'draft'" />
                        </h1>
                    </div>
                    <group>
                        <group name="scope" string="Scope">
                            <field name="instrument_id" readonly="state != 'draft'" />
                            <field
                                name="record_id"
                                readonly="state != 'draft'"
                                domain="[('instrument_id', '=', instrument_id), ('state', '=', 'approved')]"
                            />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group name="issuer" string="Issuer">
                            <field name="issuer_type" readonly="state != 'draft'" />
                            <field
                                name="issuer_partner_id"
                                invisible="issuer_type != 'external'"
                                required="issuer_type == 'external'"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="accreditation_reference"
                                invisible="issuer_type != 'external'"
                                readonly="state != 'draft'"
                            />
                            <field name="issue_date" readonly="state != 'draft'" />
                            <field name="valid_until" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group name="document" string="Document">
                        <field
                            name="certificate_file"
                            filename="certificate_filename"
                            readonly="state != 'draft'"
                        />
                        <field name="certificate_filename" invisible="1" />
                    </group>
                    <group name="notes" string="Notes">
                        <field name="note" nolabel="1" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="ls_calibration_certificate_view_search" model="ir.ui.view">
        <field name="name">ls.calibration.certificate.search</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="arch" type="xml">
            <search string="Calibration Certificates">
                <field name="name" />
                <field name="instrument_id" />
                <field name="record_id" />
                <field name="issuer_partner_id" />
                <filter
                    name="filter_issued"
                    string="Issued"
                    domain="[('state', '=', 'issued')]"
                />
                <filter
                    name="filter_external"
                    string="External"
                    domain="[('issuer_type', '=', 'external')]"
                />
                <filter
                    name="filter_expired"
                    string="Expired"
                    domain="[('valid_until', '!=', False), ('valid_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                                    <filter
                    name="group_by_instrument"
                    string="Instrument"
                    context="{'group_by': 'instrument_id'}"
                    />
                    <filter
                    name="group_by_issuer_type"
                    string="Issuer Type"
                    context="{'group_by': 'issuer_type'}"
                    />
                    <filter
                    name="group_by_state"
                    string="State"
                    context="{'group_by': 'state'}"
                    />
                    <filter
                    name="group_by_issue_date"
                    string="Issue Date"
                    context="{'group_by': 'issue_date'}"
                    />
            </search>
        </field>
    </record>

    <record id="ls_calibration_certificate_action" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">ls.calibration.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ls_calibration_certificate_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a calibration certificate</p>
            <p>
                Certificates issued internally from an approved calibration record
                and certificates received from external calibration laboratories are
                both registered here.
            </p>
        </field>
    </record>

</odoo>
