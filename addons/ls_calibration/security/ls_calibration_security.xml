<odoo>

    <!-- Security groups.
         The groups are intentionally created without a category. The Odoo 19
         refactoring of res.groups categories into privileges could not be
         verified from official documentation, and an unverified field name
         would prevent the module from being installed. Assign the groups to
         a privilege in the target environment if a grouped presentation is
         required in the user form. -->
    <record id="group_ls_calibration_viewer" model="res.groups">
        <field name="name">Calibration / Viewer</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="comment"
        >Read-only access to the instrument register, the calibration plans, the calibration records and the calibration certificates.</field>
    </record>

    <record id="group_ls_calibration_technician" model="res.groups">
        <field name="name">Calibration / Technician</field>
        <field
            name="implied_ids"
            eval="[(4, ref('ls_calibration.group_ls_calibration_viewer'))]"
        />
        <field
            name="comment"
        >Performs the calibrations, records the as-found and as-left readings, submits the calibration records for approval and registers the calibration certificates.</field>
    </record>

    <record id="group_ls_calibration_manager" model="res.groups">
        <field name="name">Calibration / Manager</field>
        <field
            name="implied_ids"
            eval="[(4, ref('ls_calibration.group_ls_calibration_technician'))]"
        />
        <field
            name="comment"
        >Maintains the instrument register and the calibration plans, approves or rejects the calibration records and issues the calibration certificates.</field>
    </record>

    <!-- Multi-company record rules. A rule that is not attached to any
         group applies to every user and is therefore global. -->
    <record id="ls_calibration_instrument_company_rule" model="ir.rule">
        <field name="name">Calibration instrument: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_instrument" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_calibration_plan_company_rule" model="ir.rule">
        <field name="name">Calibration plan: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_plan" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_calibration_plan_point_company_rule" model="ir.rule">
        <field name="name">Calibration plan test point: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_plan_point" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_calibration_record_company_rule" model="ir.rule">
        <field name="name">Calibration record: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_record" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_calibration_record_line_company_rule" model="ir.rule">
        <field name="name">Calibration record test point: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_record_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ls_calibration_certificate_company_rule" model="ir.rule">
        <field name="name">Calibration certificate: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_certificate" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
