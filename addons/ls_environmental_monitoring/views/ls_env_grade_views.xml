<odoo>
    <data>
        <record id="view_ls_env_grade_list" model="ir.ui.view">
            <field name="name">ls.env.grade.list</field>
            <field name="model">ls.env.grade</field>
            <field name="arch" type="xml">
                <list string="Cleanroom Grades">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="reference_document"/>
                    <field name="area_count" string="Areas"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_ls_env_grade_form" model="ir.ui.view">
            <field name="name">ls.env.grade.form</field>
            <field name="model">ls.env.grade</field>
            <field name="arch" type="xml">
                <form string="Cleanroom Grade">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Grade designation"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="reference_document"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ls_env_grade" model="ir.actions.act_window">
            <field name="name">Cleanroom Grades</field>
            <field name="res_model">ls.env.grade</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define a cleanroom classification grade</p>
                <p>Grades describe the classification scheme used at your site. Acceptance criteria are configured per sampling point, not on the grade.</p>
            </field>
        </record>

    </data>
</odoo>
