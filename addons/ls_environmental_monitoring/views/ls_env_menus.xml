<odoo>
    <data>

        <!--
            No menu item below declares a group restriction.

            Odoo 19 renamed the field that links a menu item to its groups, and
            the new name could not be verified from official documentation.
            Referencing a field that does not exist would prevent the module
            from installing. Menu visibility therefore relies on the access
            control lists: a user without read access to the underlying model
            does not see the corresponding menu entry.

            See doc/deviations.md for the full record of this decision.
        -->

        <menuitem id="menu_ls_env_root"
                  name="Environmental Monitoring"
                  sequence="85"
                  web_icon="ls_environmental_monitoring,static/description/icon.png"/>

