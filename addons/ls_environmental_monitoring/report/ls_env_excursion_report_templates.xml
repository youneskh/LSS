<odoo>
    <template id="report_ls_env_excursion_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Environmental Monitoring Excursion</h2>
                        <h3 t-field="doc.name"/>

                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Sample:</strong> <span t-field="doc.sample_id"/><br/>
                                <strong>Sampling Point:</strong> <span t-field="doc.sampling_point_id"/><br/>
                                <strong>Area:</strong> <span t-field="doc.area_id"/><br/>
                                <strong>Batch Reference:</strong> <span t-field="doc.batch_reference"/>
                            </div>
                            <div class="col-6">
                                <strong>Detected On:</strong> <span t-field="doc.detection_date"/><br/>
                                <strong>Breach Type:</strong> <span t-field="doc.excursion_type"/><br/>
                                <strong>Severity:</strong> <span t-field="doc.severity"/><br/>
                                <strong>Product Impact:</strong> <span t-field="doc.product_impact"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <h4>Breaching Results</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Parameter</th>
                                    <th class="text-end">Value</th>
                                    <th>Unit</th>
                                    <th class="text-end">Action Limit</th>
                                    <th>Outcome</th>
                                    <th>Organism</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.result_ids" t-as="result">
                                    <td><span t-field="result.parameter_id"/></td>
                                    <td class="text-end"><span t-field="result.value_numeric"/></td>
                                    <td><span t-field="result.uom_label"/></td>
                                    <td class="text-end"><span t-field="result.applied_action_value"/></td>
                                    <td><span t-field="result.evaluation"/></td>
                                    <td><span t-field="result.microbial_identification"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Immediate Actions</h4>
                        <p t-field="doc.immediate_actions"/>

                        <h4>Impact Assessment</h4>
                        <p t-field="doc.impact_assessment"/>

                        <div t-if="doc.investigation_required">
                            <h4>Root Cause</h4>
                            <p t-field="doc.root_cause"/>
                            <h4>Corrective Actions</h4>
                            <p t-field="doc.corrective_actions"/>
                        </div>

                        <div t-if="doc.external_reference">
                            <h4>External Record Reference</h4>
                            <p t-field="doc.external_reference"/>
                        </div>

                        <div t-if="doc.state == 'closed'">
                            <h4>Closure</h4>
                            <p>
                                Closed by <span t-field="doc.closed_by_id"/>
                                on <span t-field="doc.closure_datetime"/>.
                            </p>
                            <p t-field="doc.closure_justification"/>
                        </div>

                        <p class="text-muted mt32">
                            This record is a printed extract of an electronic record. The
                            electronic record held in the system is the primary record.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
