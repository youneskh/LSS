            <field name="model_id" ref="model_ls_cosmetic_safety_assessment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_ls_cosmetic_claim_company" model="ir.rule">
            <field name="name">Cosmetic claim: multi-company</field>
            <field name="model_id" ref="model_ls_cosmetic_claim"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_ls_cosmetic_claim_evidence_company" model="ir.rule">
            <field name="name">Cosmetic claim evidence: multi-company</field>
            <field name="model_id" ref="model_ls_cosmetic_claim_evidence"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_ls_cosmetic_label_company" model="ir.rule">
            <field name="name">Cosmetic label: multi-company</field>
            <field name="model_id" ref="model_ls_cosmetic_label"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_ls_cosmetic_pif_company" model="ir.rule">
            <field name="name">Cosmetic product information file: multi-company</field>
            <field name="model_id" ref="model_ls_cosmetic_pif"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_ls_cosmetic_dz_authorization_company" model="ir.rule">
            <field name="name">Algerian prior authorisation: multi-company</field>
            <field name="model_id" ref="model_ls_cosmetic_dz_authorization"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
