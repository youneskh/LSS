<odoo>

    <!--
        Odoo 19 replaced res.groups.category_id with res.groups.privilege_id,
        which points at the new res.groups.privilege model. The module
        category is carried by the privilege record instead of the group.
    -->
    <record id="module_category_life_sciences" model="ir.module.category">
        <field name="name">Life Sciences</field>
        <field name="description">Roles for the Life Sciences Suite.</field>
        <field name="sequence">90</field>
    </record>

    <record id="privilege_ls_signature" model="res.groups.privilege">
        <field name="name">Electronic Signatures</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_life_sciences"/>
    </record>

    <record id="group_ls_signature_signer" model="res.groups">
        <field name="name">Signer</field>
        <field name="privilege_id" ref="privilege_ls_signature"/>
        <field name="comment">May execute electronic signatures and see their own signature history.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ls_signature_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_ls_signature"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_signature_signer'))]"/>
        <field name="comment">May read every signature record of the accessible companies.</field>
    </record>

    <record id="group_ls_signature_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="privilege_id" ref="privilege_ls_signature"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_signature_viewer'))]"/>
        <field name="comment">May read signatures, attempts, sessions and integrity checks. Read only by design, so that an auditor can never alter the evidence being audited.</field>
    </record>

    <record id="group_ls_signature_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ls_signature"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_signature_auditor'))]"/>
        <field name="comment">May configure meanings and policies. Holds no write or delete right over signature records.</field>
    </record>

    <record id="group_ls_signature_security" model="res.groups">
        <field name="name">Security Unit</field>
        <field name="privilege_id" ref="privilege_ls_signature"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_signature_auditor'))]"/>
        <field name="comment">Receives the immediate notification of attempted unauthorised use of an identification code or password, as required by 21 CFR 11.300(d).</field>
    </record>

</odoo>
