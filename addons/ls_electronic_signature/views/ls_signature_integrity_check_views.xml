<odoo>

    <record id="view_ls_signature_integrity_check_list" model="ir.ui.view">
        <field name="name">ls.signature.integrity.check.list</field>
        <field name="model">ls.signature.integrity.check</field>
        <field name="arch" type="xml">
            <list string="Integrity Checks" create="false" edit="false" delete="false"
                  decoration-danger="state == 'failed'" decoration-success="state == 'passed'">
                <field name="checked_at"/>
                <field name="company_id"/>
                <field name="trigger"/>
                <field name="state" widget="badge"/>
                <field name="entries_checked"/>
                <field name="first_divergence_log_id" optional="show"/>
                <field name="checked_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_signature_integrity_check_form" model="ir.ui.view">
        <field name="name">ls.signature.integrity.check.form</field>
        <field name="model">ls.signature.integrity.check</field>
        <field name="arch" type="xml">
            <form string="Integrity Check" create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        The signature hash chain does not verify. Treat this as a suspected
                        data integrity event and open a deviation.
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="checked_at"/>
                            <field name="checked_by_id"/>
                        </group>
                        <group>
                            <field name="trigger"/>
                            <field name="state"/>
                            <field name="entries_checked"/>
                            <field name="first_divergence_log_id"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ls_signature_integrity_check" model="ir.actions.act_window">
        <field name="name">Integrity Checks</field>
        <field name="res_model">ls.signature.integrity.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_ls_signature_integrity_run" model="ir.actions.server">
        <field name="name">Verify Signature Chain Now</field>
        <field name="model_id" ref="model_ls_signature_integrity_check"/>
        <field name="state">code</field>
        <field name="code">action = model.action_run_now()</field>
    </record>

</odoo>
