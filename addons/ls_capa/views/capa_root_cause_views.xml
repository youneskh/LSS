<odoo>

    <record id="view_ls_capa_root_cause_form" model="ir.ui.view">
        <field name="name">ls.capa.root_cause.form</field>
        <field name="model">ls.capa.root_cause</field>
        <field name="arch" type="xml">
            <form string="Root Cause Analysis">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="ls_capa.group_ls_capa_investigator"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'confirmed'"
                            groups="ls_capa.group_ls_capa_investigator"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="issue_id"
                                   readonly="context.get('default_issue_id', False)"/>
                            <field name="method"/>
                            <field name="is_primary"/>
                        </group>
                        <group>
                            <field name="analyst_id"/>
                            <field name="date_analysis"/>
                            <field name="sequence" groups="base.group_no_one"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Root Cause Statement">
                        <field name="description" nolabel="1"
                               placeholder="State the root cause as a verifiable cause, not a symptom."/>
                    </group>
                    <group string="Five Whys" invisible="method != 'five_whys'">
                        <field name="why_1" placeholder="Why did the issue occur?"/>
                        <field name="why_2"/>
                        <field name="why_3"/>
                        <field name="why_4"/>
                        <field name="why_5"/>
                    </group>
                    <group string="Ishikawa" invisible="method != 'ishikawa'">
                        <field name="ishikawa_category"/>
                    </group>
                    <group string="FMEA" invisible="method != 'fmea'">
                        <group>
                            <field name="fmea_severity"/>
                            <field name="fmea_occurrence"/>
                            <field name="fmea_detection"/>
                        </group>
                        <group>
                            <field name="fmea_rpn"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Actions" name="actions">
                            <field name="action_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="description"/>
                                    <field name="responsible_id"/>
                                    <field name="date_planned"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_ls_capa_root_cause_list" model="ir.ui.view">
        <field name="name">ls.capa.root_cause.list</field>
        <field name="model">ls.capa.root_cause</field>
        <field name="arch" type="xml">
            <list string="Root Cause Analyses">
                <field name="name"/>
                <field name="issue_id"/>
                <field name="method"/>
                <field name="description"/>
                <field name="is_primary"/>
                <field name="fmea_rpn" optional="hide"/>
                <field name="analyst_id"/>
                <field name="date_analysis"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_ls_capa_root_cause_search" model="ir.ui.view">
        <field name="name">ls.capa.root_cause.search</field>
        <field name="model">ls.capa.root_cause</field>
        <field name="arch" type="xml">
            <search string="Search Root Cause Analyses">
                <field name="name"/>
                <field name="issue_id"/>
                <field name="description"/>
                <field name="analyst_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_primary" string="Primary Root Cause"
                        domain="[('is_primary', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_issue" string="CAPA"
                            context="{'group_by': 'issue_id'}"/>
                    <filter name="group_method" string="Method"
                            context="{'group_by': 'method'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_analyst" string="Analyst"
                            context="{'group_by': 'analyst_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ls_capa_root_cause" model="ir.actions.act_window">
        <field name="name">Root Cause Analyses</field>
        <field name="res_model">ls.capa.root_cause</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_capa_root_cause_search"/>
    </record>

</odoo>
