<odoo>

    <record id="view_ls_capa_issue_form" model="ir.ui.view">
        <field name="name">ls.capa.issue.form</field>
        <field name="model">ls.capa.issue</field>
        <field name="arch" type="xml">
            <form string="CAPA Record">
                <header>
                    <button name="action_assess" type="object" string="Assess"
                            class="btn-primary" invisible="state != 'identified'"
                            groups="ls_capa.group_ls_capa_investigator"/>
                    <button name="action_start_investigation" type="object"
                            string="Start Investigation" class="btn-primary"
                            invisible="state != 'assessed'"
                            groups="ls_capa.group_ls_capa_investigator"/>
                    <button name="action_start_action_planning" type="object"
                            string="Plan Actions" class="btn-primary"
                            invisible="state != 'investigation'"
                            groups="ls_capa.group_ls_capa_coordinator"/>
                    <button name="action_start_progress" type="object"
                            string="Start Execution" class="btn-primary"
                            invisible="state != 'action_planning'"
                            groups="ls_capa.group_ls_capa_coordinator"/>
                    <button name="action_complete" type="object"
                            string="Complete" class="btn-primary"
                            invisible="state != 'in_progress'"
                            groups="ls_capa.group_ls_capa_coordinator"/>
                    <button name="action_verify" type="object"
                            string="Verify Effectiveness" class="btn-primary"
                            invisible="state != 'completed'"
                            groups="ls_capa.group_ls_capa_manager"/>
                    <button name="action_open_close_wizard" type="object"
                            string="Close CAPA" class="btn-primary"
                            invisible="state != 'verified'"
                            groups="ls_capa.group_ls_capa_manager"/>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_root_causes" type="object"
                                class="oe_stat_button" icon="fa-search">
                            <field name="root_cause_count" widget="statinfo"
                                   string="Root Causes"/>
                        </button>
                        <button name="action_view_actions" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="action_count" widget="statinfo"
                                   string="Actions"/>
                        </button>
                        <button name="action_view_effectiveness" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="effectiveness_count" widget="statinfo"
                                   string="Checks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Short issue statement"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="source"/>
                            <field name="source_reference"/>
                            <field name="capa_type"/>
                            <field name="severity"/>
                            <field name="priority" widget="priority"/>
                            <field name="category_id"/>
                        </group>
                        <group string="Ownership and Dates">
                            <field name="identified_by_id"/>
                            <field name="owner_id"/>
                            <field name="date_identified"/>
                            <field name="date_due"/>
                            <field name="days_to_due"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue" name="issue">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Describe what was observed, where and when."/>
                            </group>
                            <group string="Immediate Action / Correction">
                                <field name="immediate_action" nolabel="1"
                                       placeholder="Containment action already taken."/>
                            </group>
                        </page>
                        <page string="Impact Assessment" name="impact">
                            <group>
                                <group>
                                    <field name="quality_impact"/>
                                    <field name="regulatory_impact"/>
                                    <field name="safety_impact"/>
                                </group>
                            </group>
                            <group>
                                <field name="impact_assessment" nolabel="1"
                                       placeholder="Assess the effect on product quality, patient safety and regulatory status."/>
                            </group>
                        </page>
                        <page string="Root Cause Analysis" name="root_cause">
                            <field name="root_cause_ids"
                                   context="{'default_issue_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="method"/>
                                    <field name="description"/>
                                    <field name="is_primary" widget="boolean_toggle"/>
                                    <field name="fmea_rpn" optional="hide"/>
                                    <field name="analyst_id"/>
                                    <field name="date_analysis"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'confirmed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actions" name="actions">
                            <field name="action_ids"
                                   context="{'default_issue_id': id}">
                                <list decoration-danger="is_late">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="description"/>
                                    <field name="responsible_id"/>
                                    <field name="date_planned"/>
                                    <field name="date_done" optional="show"/>
                                    <field name="is_late" invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Effectiveness" name="effectiveness">
                            <field name="effectiveness_ids"
                                   context="{'default_issue_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="method"/>
                                    <field name="criteria"/>
                                    <field name="verifier_id"/>
                                    <field name="date_planned"/>
                                    <field name="date_check" optional="show"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'effective'"
                                           decoration-danger="result == 'not_effective'"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Closure" name="closure"
                              invisible="state not in ['verified', 'closed']">
                            <group>
                                <group>
                                    <field name="date_closed"/>
                                    <field name="closed_by_id"/>
                                </group>
                            </group>
                            <group string="Closure Summary">
                                <field name="closure_summary" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_ls_capa_issue_list" model="ir.ui.view">
        <field name="name">ls.capa.issue.list</field>
        <field name="model">ls.capa.issue</field>
        <field name="arch" type="xml">
            <list string="CAPA Records"
                  decoration-danger="is_overdue"
                  decoration-muted="state == 'closed'"
                  decoration-bf="severity == 'critical'">
                <field name="name"/>
                <field name="title"/>
                <field name="source"/>
                <field name="category_id" optional="show"/>
                <field name="capa_type" optional="hide"/>
                <field name="severity"/>
                <field name="priority" widget="priority" optional="hide"/>
                <field name="owner_id"/>
                <field name="date_identified"/>
                <field name="date_due"/>
                <field name="progress" widget="progressbar"/>
                <field name="is_overdue" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-info="state in ['identified', 'assessed']"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_capa_issue_kanban" model="ir.ui.view">
        <field name="name">ls.capa.issue.kanban</field>
        <field name="model">ls.capa.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="is_overdue"/>
                <field name="severity"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="title"/>
                                    </div>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge text-bg-secondary">
                                    <field name="severity"/>
                                </span>
                                <span t-if="record.is_overdue.raw_value"
                                      class="badge text-bg-danger ms-1">Overdue</span>
                                <div class="mt-1">
                                    <i class="fa fa-clock-o" title="Due Date"/>
                                    <field name="date_due"/>
                                </div>
                                <field name="progress" widget="progressbar"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ls_capa_issue_search" model="ir.ui.view">
        <field name="name">ls.capa.issue.search</field>
        <field name="model">ls.capa.issue</field>
        <field name="arch" type="xml">
            <search string="Search CAPA Records">
                <field name="name" string="Reference"/>
                <field name="title"/>
                <field name="description"/>
                <field name="source_reference"/>
                <field name="owner_id"/>
                <field name="category_id"/>
                <separator/>
                <filter name="filter_my_capa" string="My CAPA Records"
                        domain="[('owner_id', '=', uid)]"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', '!=', 'closed')]"/>
                <filter name="filter_closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_critical" string="Critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter name="filter_regulatory_impact" string="Regulatory Impact"
                        domain="[('regulatory_impact', '=', True)]"/>
                <separator/>
                <filter name="filter_identified_this_year" string="Identified This Year"
                        domain="[('date_identified', '&gt;=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_severity" string="Severity"
                            context="{'group_by': 'severity'}"/>
                    <filter name="group_source" string="Source"
                            context="{'group_by': 'source'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_capa_type" string="CAPA Type"
                            context="{'group_by': 'capa_type'}"/>
                    <filter name="group_owner" string="Owner"
                            context="{'group_by': 'owner_id'}"/>
                    <filter name="group_date_identified" string="Identification Month"
                            context="{'group_by': 'date_identified:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ls_capa_issue_pivot" model="ir.ui.view">
        <field name="name">ls.capa.issue.pivot</field>
        <field name="model">ls.capa.issue</field>
        <field name="arch" type="xml">
            <pivot string="CAPA Analysis">
                <field name="source" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_ls_capa_issue_graph" model="ir.ui.view">
        <field name="name">ls.capa.issue.graph</field>
        <field name="model">ls.capa.issue</field>
        <field name="arch" type="xml">
            <graph string="CAPA Analysis" type="bar">
                <field name="category_id"/>
                <field name="severity"/>
            </graph>
        </field>
    </record>

    <record id="action_ls_capa_issue" model="ir.actions.act_window">
        <field name="name">CAPA Records</field>
        <field name="res_model">ls.capa.issue</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_ls_capa_issue_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first CAPA record
            </p>
            <p>
                A CAPA record documents a quality issue, its root cause,
                the corrective and preventive actions taken, and the
                verification that those actions were effective.
            </p>
        </field>
    </record>

    <record id="action_ls_capa_issue_my" model="ir.actions.act_window">
        <field name="name">My CAPA Records</field>
        <field name="res_model">ls.capa.issue</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_ls_capa_issue_search"/>
        <field name="domain">[('owner_id', '=', uid)]</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

</odoo>
