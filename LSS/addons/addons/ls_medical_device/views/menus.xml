<odoo>

    <!--
        Menu structure. This file is loaded last so that every action it
        references has already been created.

        Access is granted through the four groups of this module. The viewer
        group is implied by the user group, which is implied by the regulatory
        group, which is implied by the manager group, so attaching a menu to
        the viewer group makes it visible to all four levels.
    -->

    <menuitem id="menu_ls_md_root"
              name="Medical Devices"
              web_icon="ls_medical_device,static/description/icon.png"
              sequence="55"
              groups="group_ls_md_viewer"/>

    <!-- Devices -->
    <menuitem id="menu_ls_md_devices"
              name="Devices"
              parent="menu_ls_md_root"
              sequence="10"
              groups="group_ls_md_viewer"/>

    <menuitem id="menu_ls_md_device_register"
              name="Device Register"
              parent="menu_ls_md_devices"
              action="action_ls_md_device"
              sequence="10"/>

    <menuitem id="menu_ls_md_udi"
              name="UDI Assignments"
              parent="menu_ls_md_devices"
              action="action_ls_md_udi"
              sequence="20"/>

