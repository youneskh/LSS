     The entries below correspond to the kinds of clinical data addressed by
     Part A of Annex XIV of Regulation (EU) 2017/745. The catalogue is editable
     because Annex XIV Part A does not close the list of admissible sources.
-->
<odoo>
    <data noupdate="1">

        <record id="clinical_evidence_source_investigation" model="ls.md.clinical_evidence_source">
            <field name="name">Clinical Investigation</field>
            <field name="code">clinical_investigation</field>
            <field name="sequence">10</field>
            <field name="description">Data generated by a clinical investigation of the device concerned.</field>
        </record>

        <record id="clinical_evidence_source_literature" model="ls.md.clinical_evidence_source">
            <field name="name">Scientific Literature</field>
            <field name="code">literature</field>
            <field name="sequence">20</field>
            <field name="description">Data identified through a documented search of the scientific literature.</field>
        </record>

        <record id="clinical_evidence_source_equivalence" model="ls.md.clinical_evidence_source">
            <field name="name">Data From an Equivalent Device</field>
            <field name="code">equivalence</field>
            <field name="sequence">30</field>
            <field name="description">Data relating to a device demonstrated to be equivalent, where access to the underlying data is available.</field>
        </record>

        <record id="clinical_evidence_source_pmcf" model="ls.md.clinical_evidence_source">
            <field name="name">Post-Market Clinical Follow-up Data</field>
            <field name="code">pmcf</field>
            <field name="sequence">40</field>
            <field name="description">Data generated by the implementation of the post-market clinical follow-up plan.</field>
        </record>

        <record id="clinical_evidence_source_registry" model="ls.md.clinical_evidence_source">
            <field name="name">Registry or Real-World Data</field>
            <field name="code">registry</field>
            <field name="sequence">50</field>
            <field name="description">Data drawn from registries, observational studies or other real-world sources.</field>
        </record>

    </data>
</odoo>
