<odoo>

    <record id="view_ls_md_device_state_wizard_form" model="ir.ui.view">
        <field name="name">ls.md.device.state.wizard.form</field>
        <field name="model">ls.md.device.state.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Device Status">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        The justification entered below is written to the device record and to its
                        message history, so that the reason for the status change remains available
                        for later review.
                    </div>
                    <group>
                        <group>
                            <field name="device_id" readonly="1"/>
                            <field name="current_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="target_state"/>
                            <field name="effective_date"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="reason" nolabel="1" placeholder="Reason for the status change"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ls_md_device_state_wizard" model="ir.actions.act_window">
        <field name="name">Change Device Status</field>
        <field name="res_model">ls.md.device.state.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
