<odoo>

    <record id="action_report_ls_cosmetic_formulation" model="ir.actions.report">
        <field name="name">Formulation Composition</field>
        <field name="model">ls.cosmetic.formulation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_cosmetics.report_ls_cosmetic_formulation</field>
        <field name="report_file">ls_cosmetics.report_ls_cosmetic_formulation</field>
        <field name="binding_model_id" ref="model_ls_cosmetic_formulation"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Formulation - %s v%s' % (object.code, object.version)</field>
    </record>

