<odoo>
    <data noupdate="0">

        <!-- Application category shared by the Life Sciences Suite modules. -->
        <record id="module_category_life_sciences" model="ir.module.category">
            <field name="name">Life Sciences</field>
            <field name="description">Quality and compliance applications for
                regulated life sciences environments.</field>
            <field name="sequence">90</field>
        </record>

        <!--
            Odoo 19 groups the security roles of an application under a
            res.groups.privilege record; res.groups no longer references
            ir.module.category directly.
        -->
        <record id="privilege_ls_validation" model="res.groups.privilege">
            <field name="name">Validation Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_life_sciences"/>
        </record>

        <record id="group_ls_validation_viewer" model="res.groups">
            <field name="name">Validation: Viewer</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_ls_validation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read only access to the validation
                documentation, execution records and signatures.</field>
        </record>

        <record id="group_ls_validation_engineer" model="res.groups">
            <field name="name">Validation: Engineer</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_ls_validation"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_ls_validation_viewer'))]"/>
            <field name="comment">Writes master plans, protocols, executes
                tests and raises discrepancies. Cannot approve.</field>
        </record>

        <record id="group_ls_validation_approver" model="res.groups">
            <field name="name">Validation: Approver</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="privilege_ls_validation"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_ls_validation_engineer'))]"/>
            <field name="comment">Approves master plans, protocols, execution
                records and validation summary reports with an electronic
                signature.</field>
        </record>

        <record id="group_ls_validation_manager" model="res.groups">
            <field name="name">Validation: Manager</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="privilege_ls_validation"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_ls_validation_approver'))]"/>
            <field name="comment">Administers the validation programme,
                including the deletion of draft records and the configuration
                of the module.</field>
        </record>

    </data>
</odoo>
