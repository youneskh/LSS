<odoo>
    <data noupdate="1">

        <!--
            Global multi-company rules. A record without company is visible to
            everybody, a record with a company is only visible to users having
            that company enabled.
        -->
        <record id="rule_ls_validation_item_company" model="ir.rule">
            <field name="name">Validation Item: multi-company</field>
            <field name="model_id" ref="model_ls_validation_item"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="rule_ls_validation_master_plan_company" model="ir.rule">
            <field name="name">Validation Master Plan: multi-company</field>
