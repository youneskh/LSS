<odoo>

    <!--
        Multi-company isolation.

        Every rule below is a global rule: no group is attached to it, so it
        applies to every user without exception, including administrators.
        A global rule is the correct construct for company isolation, because
        an isolation that a role could bypass would not be an isolation.

        The computed "global" field of ir.rule is never written here; it is
        derived by the framework from the absence of groups.

        The domain uses the "company_ids" key of the evaluation context, which
        holds the companies the user has currently enabled. Records without a
        company remain visible so that data shared across companies is not
        hidden.

        Models excluded from this file and the reason for each exclusion:

        * ls.pharma.stability.condition: reference data shared by every
          company; it carries no company field.
        * the three transient wizard models: a transient record is already
          restricted to the user that created it by the framework.
    -->

    <record id="rule_ls_pharma_api_company" model="ir.rule">
        <field name="name">Active ingredient: multi-company</field>
        <field name="model_id" ref="model_ls_pharma_api"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

