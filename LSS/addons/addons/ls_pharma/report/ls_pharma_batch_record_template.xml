     Printed batch production and control record.

     The sections follow the thirteen items required by 21 CFR 211.188(b).
     Items that this module does not hold are not printed and are listed in
     the closing note, so that a reader can never mistake the printed
     document for a complete batch record. -->
<odoo>

    <template id="report_batch_record_document">
        <t t-call="web.external_layout">
            <div class="page">

                <h2>
                    Batch Production and Control Record
                </h2>
                <h3 t-field="doc.name"/>

                <div class="row mt-4">
                    <div class="col-6">
                        <strong>Batch</strong>
                        <div t-field="doc.batch_id"/>
                        <strong>Product</strong>
                        <div t-field="doc.product_id"/>
                        <strong>Record Type</strong>
                        <div t-field="doc.record_type"/>
                    </div>
                    <div class="col-6">
                        <strong>Master Production Record</strong>
                        <div t-field="doc.master_record_reference"/>
                        <strong>Master Record Version</strong>
                        <div t-field="doc.master_record_version"/>
                        <strong>Status</strong>
                        <div t-field="doc.state"/>
                    </div>
                </div>

                <div class="row mt-3" t-if="doc.batch_id">
                    <div class="col-4">
                        <strong>Theoretical Yield</strong>
                        <div>
                            <span t-field="doc.batch_id.theoretical_yield_qty"/>
                            <span t-field="doc.batch_id.uom_id"/>
                        </div>
                    </div>
                    <div class="col-4">
                        <strong>Actual Yield</strong>
                        <div>
                            <span t-field="doc.batch_id.actual_yield_qty"/>
                            <span t-field="doc.batch_id.uom_id"/>
                        </div>
                    </div>
                    <div class="col-4">
                        <strong>Yield (%)</strong>
                        <div t-field="doc.batch_id.yield_percentage"/>
                    </div>
                </div>

                <h4 class="mt-4">Components Charged</h4>
                <table class="table table-sm o_main_table"
                       t-if="doc.batch_id and doc.batch_id.component_ids">
                    <thead>
                        <tr>
                            <th>Component</th>
                            <th>Lot</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit</th>
                            <th class="text-end">Assay (%)</th>
                            <th class="text-end">Charged</th>
                            <th>Charged By</th>
                            <th>Verified By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.batch_id.component_ids" t-as="component">
                            <td><span t-field="component.product_id"/></td>
                            <td>
                                <span t-field="component.component_lot_id"/>
                                <span t-field="component.component_lot_reference"/>
                            </td>
                            <td class="text-end"><span t-field="component.quantity"/></td>
                            <td><span t-field="component.uom_id"/></td>
                            <td class="text-end"><span t-field="component.assay_percentage"/></td>
                            <td class="text-end"><span t-field="component.compensated_quantity"/></td>
                            <td><span t-field="component.charged_by_user_id"/></td>
                            <td>
                                <span t-if="component.is_automated_charge">
                                    Automated system, 21 CFR 211.101(d)
                                </span>
                                <span t-else="" t-field="component.verified_by_user_id"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">Major Equipment Used</h4>
                <table class="table table-sm o_main_table"
                       t-if="doc.batch_id and doc.batch_id.equipment_ids">
                    <thead>
                        <tr>
                            <th>Equipment</th>
                            <th>Identifier</th>
                            <th>Operation</th>
                            <th>Cleaning Record</th>
                            <th>Cleaning Verified By</th>
                            <th>Used From</th>
                            <th>Used To</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.batch_id.equipment_ids" t-as="equipment">
                            <td><span t-field="equipment.name"/></td>
                            <td><span t-field="equipment.equipment_identifier"/></td>
                            <td><span t-field="equipment.operation"/></td>
                            <td><span t-field="equipment.cleaning_record_reference"/></td>
                            <td><span t-field="equipment.cleaning_verified_by_user_id"/></td>
                            <td><span t-field="equipment.date_used_start"/></td>
                            <td><span t-field="equipment.date_used_end"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">Processing Steps</h4>
                <table class="table table-sm o_main_table" t-if="doc.step_ids">
                    <thead>
                        <tr>
                            <th>Step</th>
                            <th>Significant</th>
                            <th>Recorded Value</th>
                            <th>Unit</th>
                            <th>Performed By</th>
                            <th>Checked By</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.step_ids" t-as="step">
                            <td><span t-field="step.name"/></td>
                            <td>
                                <span t-if="step.is_significant">Yes</span>
                                <span t-else="">No</span>
                            </td>
                            <td><span t-field="step.recorded_value"/></td>
                            <td><span t-field="step.recorded_uom"/></td>
                            <td><span t-field="step.performed_by_user_id"/></td>
                            <td>
                                <span t-if="step.is_automated">
                                    Automated
                                </span>
                                <span t-else="" t-field="step.checked_by_user_id"/>
                            </td>
                            <td><span t-field="step.date_performed"/></td>
                            <td><span t-field="step.state"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">In-Process and Laboratory Controls</h4>
                <table class="table table-sm o_main_table" t-if="doc.control_ids">
                    <thead>
                        <tr>
                            <th>Control</th>
                            <th>Type</th>
                            <th>Specification</th>
                            <th class="text-end">Result</th>
                            <th>Unit</th>
                            <th>Conform</th>
                            <th>Performed By</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.control_ids" t-as="control">
                            <td><span t-field="control.name"/></td>
                            <td><span t-field="control.control_type"/></td>
                            <td><span t-field="control.specification_text"/></td>
                            <td class="text-end">
                                <span t-if="control.result_type == 'numeric'"
                                      t-field="control.result_value"/>
                                <span t-else="" t-field="control.result_text"/>
                            </td>
                            <td><span t-field="control.result_uom"/></td>
                            <td>
                                <span t-if="control.is_conform">Yes</span>
                                <span t-else="">No</span>
                            </td>
                            <td><span t-field="control.performed_by_user_id"/></td>
                            <td><span t-field="control.date_performed"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">Line Clearance</h4>
                <table class="table table-sm o_main_table" t-if="doc.clearance_ids">
                    <thead>
                        <tr>
                            <th>Moment</th>
                            <th>Area</th>
                            <th>Previous Product</th>
                            <th>Date</th>
                            <th>Performed By</th>
                            <th>Verified By</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.clearance_ids" t-as="clearance">
                            <td><span t-field="clearance.moment"/></td>
                            <td><span t-field="clearance.area"/></td>
                            <td><span t-field="clearance.previous_product"/></td>
                            <td><span t-field="clearance.date_performed"/></td>
                            <td><span t-field="clearance.performed_by_user_id"/></td>
                            <td><span t-field="clearance.verified_by_user_id"/></td>
                            <td><span t-field="clearance.result"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">Labelling Reconciliation</h4>
                <table class="table table-sm o_main_table" t-if="doc.labeling_ids">
                    <thead>
                        <tr>
                            <th>Labelling</th>
                            <th>Code</th>
                            <th class="text-end">Issued</th>
                            <th class="text-end">Used</th>
                            <th class="text-end">Returned</th>
                            <th class="text-end">Destroyed</th>
                            <th class="text-end">Difference</th>
                            <th>Reconciled</th>
                            <th>Checked By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.labeling_ids" t-as="labeling">
                            <td><span t-field="labeling.name"/></td>
                            <td><span t-field="labeling.label_code"/></td>
                            <td class="text-end"><span t-field="labeling.quantity_issued"/></td>
                            <td class="text-end"><span t-field="labeling.quantity_used"/></td>
                            <td class="text-end"><span t-field="labeling.quantity_returned"/></td>
                            <td class="text-end"><span t-field="labeling.quantity_destroyed"/></td>
                            <td class="text-end"><span t-field="labeling.quantity_difference"/></td>
                            <td>
                                <span t-if="labeling.is_reconciled">Yes</span>
                                <span t-else="">No</span>
                            </td>
                            <td><span t-field="labeling.checked_by_user_id"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">Samples</h4>
                <table class="table table-sm o_main_table" t-if="doc.sample_ids">
                    <thead>
                        <tr>
                            <th>Sample</th>
                            <th>Type</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit</th>
                            <th>Storage Location</th>
                            <th>Taken On</th>
                            <th>Taken By</th>
                            <th>Retained Until</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.sample_ids" t-as="sample">
                            <td><span t-field="sample.name"/></td>
                            <td><span t-field="sample.sample_type"/></td>
                            <td class="text-end"><span t-field="sample.quantity"/></td>
                            <td><span t-field="sample.uom_id"/></td>
                            <td><span t-field="sample.storage_location"/></td>
                            <td><span t-field="sample.date_taken"/></td>
                            <td><span t-field="sample.taken_by_user_id"/></td>
                            <td><span t-field="sample.retention_until"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-4">Containers and Closures</h4>
                <div t-field="doc.container_closure_description"/>
                <div t-field="doc.examination_result"/>

                <h4 class="mt-4">Discrepancies</h4>
                <p t-if="not doc.discrepancy_ids">
                    No discrepancy was recorded on this batch record.
                </p>
                <div t-foreach="doc.discrepancy_ids" t-as="discrepancy"
                     class="mb-3">
                    <strong>
                        <span t-field="discrepancy.name"/>
                        (<span t-field="discrepancy.classification"/>,
                        <span t-field="discrepancy.state"/>)
                    </strong>
                    <div>
                        Detected on <span t-field="discrepancy.date_detected"/>
                        by <span t-field="discrepancy.detected_by_user_id"/>.
                    </div>
                    <div t-field="discrepancy.description"/>
                    <div t-field="discrepancy.investigation"/>
                    <div t-if="discrepancy.extended_to_other_batches">
                        <strong>Extension to other batches: </strong>
                        <span t-field="discrepancy.extension_scope"/>
                    </div>
                    <div>
                        <strong>Conclusion: </strong>
                        <span t-field="discrepancy.conclusion"/>
                    </div>
                    <div t-if="discrepancy.follow_up">
                        <strong>Follow-up: </strong>
                        <span t-field="discrepancy.follow_up"/>
                    </div>
                </div>

                <h4 class="mt-4">Execution and Review</h4>
                <div class="row">
                    <div class="col-6">
                        <strong>Executed By</strong>
                        <div t-field="doc.executed_by_user_id"/>
                        <div t-field="doc.date_executed"/>
                    </div>
                    <div class="col-6">
                        <strong>Reviewed By</strong>
                        <div t-field="doc.reviewed_by_user_id"/>
                        <div t-field="doc.date_reviewed"/>
                    </div>
                </div>
                <div t-field="doc.review_conclusion"/>

                <p class="mt-4 text-muted">
                    This printout covers the items of 21 CFR 211.188(b) that
                    this module records. It does not carry the reproduction of
                    the appropriate master production or control record
                    required by 21 CFR 211.188(a), the identification of
                    individual major equipment beyond the entries listed above,
                    the weight or measure statements held in another system,
                    the inspection of the packaging and labelling area beyond
                    the clearances listed above, or the actual and theoretical
                    yields of intermediate stages held in another system. It is
                    not a substitute for the complete batch record of the
                    manufacturer.
                </p>

            </div>
        </t>
    </template>

    <template id="report_batch_record">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ls_pharma.report_batch_record_document"/>
            </t>
        </t>
    </template>

</odoo>
