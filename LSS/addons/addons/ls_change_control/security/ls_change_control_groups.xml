<odoo>

    <!--
        Odoo 19 replaced res.groups.category_id with res.groups.privilege_id,
        which points at the new res.groups.privilege model. The module
        category is carried by the privilege record instead of the group.
    -->
    <record id="module_category_ls_change_control" model="ir.module.category">
        <field name="name">Change Control</field>
        <field name="description">Access levels of the Life Sciences change control process.</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_ls_change_control" model="res.groups.privilege">
        <field name="name">Change Control</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ls_change_control"/>
    </record>

    <record id="group_ls_change_control_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_ls_change_control"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read only access to change requests and to the change control configuration.</field>
    </record>

    <record id="group_ls_change_control_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="privilege_id" ref="privilege_ls_change_control"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_change_control_viewer'))]"/>
        <field name="comment">May create change requests, edit their own draft requests, complete the impact assessments assigned to them and execute the implementation actions and verifications they are responsible for.</field>
    </record>

    <record id="group_ls_change_control_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_ls_change_control"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_change_control_requester'))]"/>
        <field name="comment">May record the approval decisions assigned to them, in addition to the rights of a requester.</field>
    </record>

    <record id="group_ls_change_control_manager" model="res.groups">
        <field name="name">Change Control Manager</field>
        <field name="privilege_id" ref="privilege_ls_change_control"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_change_control_approver'))]"/>
        <field name="comment">Drives the change control process: review, generation of the assessment and approval matrix, planning of the implementation and of the verification, closure, rejection and cancellation. Also maintains the change control configuration.</field>
    </record>

</odoo>
