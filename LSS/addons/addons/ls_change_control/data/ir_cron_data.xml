     The fields numbercall and doall are deliberately not set: their presence
     on ir.cron could not be verified for Odoo 19.0 from the official
     documentation, and they are not required to schedule a recurring job. -->
<odoo>
    <data noupdate="1">

        <record id="cron_ls_cc_remind_pending_approvals" model="ir.cron">
            <field name="name">Change Control: remind pending approvals</field>
            <field name="model_id" ref="model_ls_change_control_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_pending_approvals()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>

        <record id="cron_ls_cc_remind_overdue_implementations" model="ir.cron">
            <field name="name">Change Control: remind overdue implementations</field>
            <field name="model_id" ref="model_ls_change_control_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_overdue_implementations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">21</field>
        </record>

        <record id="cron_ls_cc_remind_due_verifications" model="ir.cron">
            <field name="name">Change Control: remind due effectiveness verifications</field>
            <field name="model_id" ref="model_ls_change_control_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_due_verifications()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">22</field>
        </record>

    </data>
</odoo>
