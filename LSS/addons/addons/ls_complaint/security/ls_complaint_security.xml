<odoo>

    <!--
        Odoo 19 replaced res.groups.category_id with res.groups.privilege_id,
        which points at the new res.groups.privilege model. The module
        category is carried by the privilege record instead of the group.
    -->
    <record id="module_category_life_sciences_complaint" model="ir.module.category">
        <field name="name">Life Sciences Complaint Management</field>
        <field name="description">Access levels for the complaint handling process.</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_ls_complaint" model="res.groups.privilege">
        <field name="name">Complaint Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_life_sciences_complaint"/>
    </record>

    <record id="group_ls_complaint_viewer" model="res.groups">
        <field name="name">Complaint Viewer</field>
        <field name="privilege_id" ref="privilege_ls_complaint"/>
        <field name="comment">Read-only access to complaints and their child records.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ls_complaint_investigator" model="res.groups">
        <field name="name">Complaint Investigator</field>
        <field name="privilege_id" ref="privilege_ls_complaint"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_complaint_viewer'))]"/>
        <field name="comment">Records complaints, performs assessments and investigations.</field>
    </record>

    <record id="group_ls_complaint_reviewer" model="res.groups">
        <field name="name">Complaint Reviewer</field>
        <field name="privilege_id" ref="privilege_ls_complaint"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_complaint_investigator'))]"/>
        <field name="comment">Approves investigations and closes complaints.</field>
    </record>

    <record id="group_ls_complaint_manager" model="res.groups">
        <field name="name">Complaint Manager</field>
        <field name="privilege_id" ref="privilege_ls_complaint"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_complaint_reviewer'))]"/>
        <field name="comment">Administers the complaint process, its configuration and its master data.</field>
    </record>

    <!-- Multi-company record rules (global, therefore always applied). -->
    <record id="rule_ls_complaint_company" model="ir.rule">
        <field name="name">Complaint: multi-company</field>
        <field name="model_id" ref="model_ls_complaint"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_complaint_category_company" model="ir.rule">
        <field name="name">Complaint Category: multi-company</field>
        <field name="model_id" ref="model_ls_complaint_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_complaint_investigation_company" model="ir.rule">
        <field name="name">Complaint Investigation: multi-company</field>
        <field name="model_id" ref="model_ls_complaint_investigation"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_complaint_resolution_company" model="ir.rule">
        <field name="name">Complaint Resolution: multi-company</field>
        <field name="model_id" ref="model_ls_complaint_resolution"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_complaint_adverse_event_company" model="ir.rule">
        <field name="name">Complaint Adverse Event: multi-company</field>
        <field name="model_id" ref="model_ls_complaint_adverse_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Segregation of duties: an investigator may only modify the complaints
         he or she owns or received. Reviewers and managers are not restricted. -->
    <record id="rule_ls_complaint_investigator_write" model="ir.rule">
        <field name="name">Complaint: investigator writes own complaints</field>
        <field name="model_id" ref="model_ls_complaint"/>
        <field name="groups" eval="[(4, ref('group_ls_complaint_investigator'))]"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('received_by_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ls_complaint_reviewer_write" model="ir.rule">
        <field name="name">Complaint: reviewer writes all complaints</field>
        <field name="model_id" ref="model_ls_complaint"/>
        <field name="groups" eval="[(4, ref('group_ls_complaint_reviewer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
