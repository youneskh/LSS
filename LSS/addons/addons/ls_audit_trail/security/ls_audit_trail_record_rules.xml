<odoo noupdate="0">

    <!--
        All rules below are global: they carry no group restriction and are
        therefore combined with a logical AND for every user, including audit
        administrators. This is the Odoo convention for multi-company scoping
        and it deliberately avoids the record rule field that lists groups,
        whose name in Odoo 19 could not be verified from official
        documentation.

        The field 'global' of ir.rule is computed by Odoo from the absence of
        groups and is never written here.
    -->

    <record id="rule_log_company" model="ir.rule">
        <field name="name">Audit trail entry: own companies</field>
        <field name="model_id" ref="model_ls_audit_trail_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_log_line_company" model="ir.rule">
        <field name="name">Audit trail field change: own companies</field>
        <field name="model_id" ref="model_ls_audit_trail_log_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_verification_company" model="ir.rule">
        <field name="name">Integrity verification: own companies</field>
        <field name="model_id" ref="model_ls_audit_trail_verification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_evidence_pack_company" model="ir.rule">
        <field name="name">Evidence pack: own companies</field>
        <field name="model_id" ref="model_ls_audit_trail_evidence_pack"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rule_company" model="ir.rule">
        <field name="name">Audit rule: own companies or all companies</field>
        <field name="model_id" ref="model_ls_audit_trail_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
