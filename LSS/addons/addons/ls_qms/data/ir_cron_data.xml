<odoo>
    <data noupdate="1">

        <record id="ir_cron_ls_qms_document_review" model="ir.cron">
            <field name="name">LS QMS: periodic document review reminder</field>
            <field name="model_id" ref="model_ls_qms_policy"/>
            <field name="state">code</field>
            <field name="code">model._cron_document_review_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_ls_qms_objective_monitoring" model="ir.cron">
            <field name="name">LS QMS: quality objective monitoring</field>
            <field name="model_id" ref="model_ls_qms_objective"/>
            <field name="state">code</field>
            <field name="code">model._cron_objective_monitoring()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_ls_qms_record_retention" model="ir.cron">
            <field name="name">LS QMS: quality record retention review</field>
            <field name="model_id" ref="model_ls_qms_quality_record"/>
            <field name="state">code</field>
            <field name="code">model._cron_retention_review()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
