<odoo>

    <record id="ls_qms_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.qms.reject.wizard.form</field>
        <field name="model">ls.qms.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Document">
                <group>
                    <field name="document_name"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <group string="Rejection Reason">
                    <field name="reason" nolabel="1" placeholder="Explain what must be corrected before the document is submitted again."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
