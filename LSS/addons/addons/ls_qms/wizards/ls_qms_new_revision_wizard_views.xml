<odoo>

    <record id="ls_qms_new_revision_wizard_view_form" model="ir.ui.view">
        <field name="name">ls.qms.new.revision.wizard.form</field>
        <field name="model">ls.qms.new.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="New Revision">
                <group>
                    <field name="document_name"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="date_effective"/>
                </group>
                <group string="Reason for Change">
                    <field name="reason_for_change" nolabel="1" placeholder="Describe why the document is revised. This text is written to the new revision and to the message log of the current one."/>
                </group>
                <footer>
                    <button name="action_create_revision" type="object" string="Create Revision" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
