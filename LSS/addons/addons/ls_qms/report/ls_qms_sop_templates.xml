<odoo>

    <template id="report_ls_qms_sop_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center"><span t-field="doc.name"/></h2>
                        <t t-call="ls_qms.report_ls_qms_document_control_block"/>
                        <div t-if="doc.purpose">
                            <h4>1. Purpose</h4>
                            <div t-field="doc.purpose"/>
                        </div>
                        <div t-if="doc.scope">
                            <h4>2. Scope</h4>
                            <p><span t-field="doc.scope"/></p>
                        </div>
                        <div t-if="doc.definitions">
                            <h4>3. Definitions and Abbreviations</h4>
                            <p><span t-field="doc.definitions"/></p>
                        </div>
                        <div t-if="doc.responsibilities">
                            <h4>4. Responsibilities</h4>
                            <div t-field="doc.responsibilities"/>
                        </div>
                        <div t-if="doc.procedure">
                            <h4>5. Procedure</h4>
                            <div t-field="doc.procedure"/>
                        </div>
                        <div t-if="doc.reference_documents">
                            <h4>6. Reference Documents</h4>
                            <p><span t-field="doc.reference_documents"/></p>
                        </div>
                        <div t-if="doc.work_instruction_ids">
                            <h4>7. Associated Work Instructions</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Title</th>
                                        <th>Version</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.work_instruction_ids" t-as="instruction">
                                        <td><span t-field="instruction.reference"/></td>
                                        <td><span t-field="instruction.name"/></td>
                                        <td><span t-field="instruction.version"/></td>
                                        <td><span t-field="instruction.state"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-if="doc.reason_for_change">
                            <h4>8. Reason for Change</h4>
                            <p><span t-field="doc.reason_for_change"/></p>
                        </div>
                        <t t-call="ls_qms.report_ls_qms_uncontrolled_copy_notice"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
