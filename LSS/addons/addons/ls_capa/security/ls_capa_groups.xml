<odoo>

    <!-- Application category shown on the user form. -->
    <record id="module_category_life_sciences_quality" model="ir.module.category">
        <field name="name">Life Sciences Quality</field>
        <field name="description">Quality management for regulated Life Sciences operations.</field>
        <field name="sequence">45</field>
    </record>

    <!--
        Odoo 19 replaced the direct category_id link on res.groups with the
        res.groups.privilege model. Groups reference a privilege, and the
        privilege carries the module category.
    -->
    <record id="res_groups_privilege_capa" model="res.groups.privilege">
        <field name="name">CAPA Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_life_sciences_quality"/>
    </record>

    <record id="group_ls_capa_viewer" model="res.groups">
        <field name="name">CAPA Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_capa"/>
        <field name="comment">Read-only access to CAPA records, actions and effectiveness checks.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ls_capa_investigator" model="res.groups">
        <field name="name">CAPA Investigator</field>
        <field name="privilege_id" ref="res_groups_privilege_capa"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_capa_viewer'))]"/>
        <field name="comment">Creates CAPA records and performs root cause investigations.</field>
    </record>

    <record id="group_ls_capa_coordinator" model="res.groups">
        <field name="name">CAPA Coordinator</field>
        <field name="privilege_id" ref="res_groups_privilege_capa"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_capa_investigator'))]"/>
        <field name="comment">Plans and tracks CAPA actions and effectiveness checks.</field>
    </record>

    <record id="group_ls_capa_manager" model="res.groups">
        <field name="name">CAPA Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_capa"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_capa_coordinator'))]"/>
        <field name="comment">Full access, including verification, closure and configuration.</field>
    </record>

</odoo>
