<odoo>
    <data noupdate="1">

        <!--
            Multi-company isolation. Each rule is global (no group_id), so it
            applies to every user including CAPA Managers. Records are visible
            only when they belong to one of the user's allowed companies.
        -->
        <record id="ls_capa_issue_company_rule" model="ir.rule">
            <field name="name">CAPA Record: multi-company</field>
            <field name="model_id" ref="model_ls_capa_issue"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="ls_capa_root_cause_company_rule" model="ir.rule">
