<odoo>

    <record id="view_ls_capa_effectiveness_form" model="ir.ui.view">
        <field name="name">ls.capa.effectiveness.form</field>
        <field name="model">ls.capa.effectiveness</field>
        <field name="arch" type="xml">
            <form string="Effectiveness Check">
                <header>
                    <button name="action_plan" type="object" string="Plan"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="ls_capa.group_ls_capa_coordinator"/>
                    <button name="action_mark_effective" type="object"
                            string="Conclude Effective" class="btn-primary"
                            invisible="state == 'done'"
                            groups="ls_capa.group_ls_capa_coordinator"/>
                    <button name="action_mark_not_effective" type="object"
                            string="Conclude Not Effective"
                            invisible="state == 'done'"
                            groups="ls_capa.group_ls_capa_coordinator"/>
                    <button name="action_create_followup_capa" type="object"
                            string="Raise Follow-up CAPA"
                            invisible="result != 'not_effective' or new_capa_id"
                            groups="ls_capa.group_ls_capa_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="issue_id"
                                   readonly="context.get('default_issue_id', False)"/>
                            <field name="method"/>
                            <field name="verifier_id"/>
                        </group>
                        <group>
                            <field name="date_planned"/>
                            <field name="date_check"/>
                            <field name="result"/>
                            <field name="new_capa_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Acceptance Criteria">
                        <field name="criteria" nolabel="1"
                               placeholder="Define objective criteria before performing the check."/>
                    </group>
                    <group string="Conclusion">
                        <field name="conclusion" nolabel="1"
                               placeholder="State the conclusion and cite the evidence reviewed."/>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_ls_capa_effectiveness_list" model="ir.ui.view">
        <field name="name">ls.capa.effectiveness.list</field>
        <field name="model">ls.capa.effectiveness</field>
        <field name="arch" type="xml">
            <list string="Effectiveness Checks">
                <field name="name"/>
                <field name="issue_id"/>
                <field name="method"/>
                <field name="criteria"/>
                <field name="verifier_id"/>
                <field name="date_planned"/>
                <field name="date_check" optional="show"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'effective'"
                       decoration-danger="result == 'not_effective'"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ls_capa_effectiveness_search" model="ir.ui.view">
        <field name="name">ls.capa.effectiveness.search</field>
        <field name="model">ls.capa.effectiveness</field>
        <field name="arch" type="xml">
            <search string="Search Effectiveness Checks">
                <field name="name"/>
                <field name="issue_id"/>
                <field name="criteria"/>
                <field name="verifier_id"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('result', '=', 'pending')]"/>
                <filter name="filter_effective" string="Effective"
                        domain="[('result', '=', 'effective')]"/>
                <filter name="filter_not_effective" string="Not Effective"
                        domain="[('result', '=', 'not_effective')]"/>
                <group name="group_by">
                    <filter name="group_issue" string="CAPA"
                            context="{'group_by': 'issue_id'}"/>
                    <filter name="group_result" string="Result"
                            context="{'group_by': 'result'}"/>
                    <filter name="group_method" string="Method"
                            context="{'group_by': 'method'}"/>
                    <filter name="group_verifier" string="Verifier"
                            context="{'group_by': 'verifier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ls_capa_effectiveness" model="ir.actions.act_window">
        <field name="name">Effectiveness Checks</field>
        <field name="res_model">ls.capa.effectiveness</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_capa_effectiveness_search"/>
    </record>

</odoo>
