<odoo>
    <data noupdate="1">

        <!--
            Odoo 19 removed the `numbercall` and `doall` fields from
            ir.cron (removed as of Odoo 18, carried into 19). Recurrence is
            expressed solely through interval_number and interval_type. The
            job is shipped inactive; activate it under Settings > Technical
            > Scheduled Actions.
        -->
        <record id="cron_ls_capa_notify_overdue" model="ir.cron">
            <field name="name">CAPA: Notify Overdue Records</field>
            <field name="model_id" ref="model_ls_capa_issue"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
