<odoo>
    <record id="view_ls_deviation_disposition_form" model="ir.ui.view">
        <field name="name">ls.deviation.disposition.form</field>
        <field name="model">ls.deviation.disposition</field>
        <field name="arch" type="xml">
            <form string="Product Disposition">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="ls_deviation.group_ls_deviation_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'draft'"
                            groups="ls_deviation.group_ls_deviation_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="deviation_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                            <field name="decision"/>
                            <field name="approved_by_id"/>
                            <field name="approval_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Justification"/>
                    <field name="justification" nolabel="1"
                           placeholder="Scientific and quality rationale supporting the decision."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ls_deviation_disposition_list" model="ir.ui.view">
        <field name="name">ls.deviation.disposition.list</field>
        <field name="model">ls.deviation.disposition</field>
        <field name="arch" type="xml">
            <list string="Product Dispositions">
                <field name="deviation_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="decision"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_ls_deviation_disposition" model="ir.actions.act_window">
        <field name="name">Product Dispositions</field>
        <field name="res_model">ls.deviation.disposition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
