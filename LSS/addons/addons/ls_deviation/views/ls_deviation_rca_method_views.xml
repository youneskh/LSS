<odoo>
    <record id="view_ls_deviation_rca_method_list" model="ir.ui.view">
        <field name="name">ls.deviation.rca.method.list</field>
        <field name="model">ls.deviation.rca.method</field>
        <field name="arch" type="xml">
            <list string="Root Cause Analysis Methods" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_ls_deviation_rca_method" model="ir.actions.act_window">
        <field name="name">Root Cause Analysis Methods</field>
        <field name="res_model">ls.deviation.rca.method</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
