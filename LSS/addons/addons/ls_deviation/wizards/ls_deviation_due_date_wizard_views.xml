<odoo>
    <record id="view_ls_deviation_due_date_wizard_form" model="ir.ui.view">
        <field name="name">ls.deviation.due.date.wizard.form</field>
        <field name="model">ls.deviation.due.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Extend Target Closure Date">
                <field name="deviation_id" invisible="1"/>
                <group>
                    <field name="current_due_date"/>
                    <field name="new_due_date"/>
                </group>
                <separator string="Justification"/>
                <field name="justification" nolabel="1"
                       placeholder="Mandatory justification for the extension. This is posted to the deviation chatter."/>
                <footer>
                    <button name="action_confirm" string="Apply Extension"
                            type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
