<odoo>

    <record id="action_report_ls_audit_report" model="ir.actions.report">
        <field name="name">Audit Report</field>
        <field name="model">ls.audit.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_audit.report_ls_audit_report_document</field>
        <field name="report_file">ls_audit.report_ls_audit_report_document</field>
        <field name="binding_model_id" ref="model_ls_audit_report"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Audit Report - %s' % (object.reference)</field>
    </record>

    <record id="action_report_ls_audit_finding" model="ir.actions.report">
        <field name="name">Finding Notice</field>
        <field name="model">ls.audit.finding</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_audit.report_ls_audit_finding_document</field>
        <field name="report_file">ls_audit.report_ls_audit_finding_document</field>
        <field name="binding_model_id" ref="model_ls_audit_finding"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Finding - %s' % (object.reference)</field>
    </record>

</odoo>
