<odoo>

    <record id="view_ls_audit_area_list" model="ir.ui.view">
        <field name="name">ls.audit.area.list</field>
        <field name="model">ls.audit.area</field>
        <field name="arch" type="xml">
            <list string="Auditable Areas">
                <field name="code"/>
                <field name="complete_name"/>
                <field name="department_id"/>
                <field name="responsible_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ls_audit_area_form" model="ir.ui.view">
        <field name="name">ls.audit.area.form</field>
        <field name="model">ls.audit.area</field>
        <field name="arch" type="xml">
            <form string="Auditable Area">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sterile Filling"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="complete_name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Sub-Areas" name="children">
                            <field name="child_ids" nolabel="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="responsible_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_audit_area_search" model="ir.ui.view">
        <field name="name">ls.audit.area.search</field>
        <field name="model">ls.audit.area</field>
        <field name="arch" type="xml">
            <search string="Auditable Areas">
                <field name="complete_name" string="Area"/>
                <field name="code"/>
                <field name="responsible_id"/>
                <field name="department_id"/>
                <filter name="filter_top_level" string="Top Level Only" domain="[('parent_id', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                                    <filter name="group_parent" string="Parent Area" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_responsible" string="Area Owner" context="{'group_by': 'responsible_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_audit_area" model="ir.actions.act_window">
        <field name="name">Auditable Areas</field>
        <field name="res_model">ls.audit.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_audit_area_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map your auditable areas</p>
            <p>An area is any site, department, process or system that can be placed in the scope of an audit. Areas are hierarchical.</p>
        </field>
    </record>

</odoo>
