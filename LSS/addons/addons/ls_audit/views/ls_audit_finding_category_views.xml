<odoo>

    <record id="view_ls_audit_finding_category_list" model="ir.ui.view">
        <field name="name">ls.audit.finding.category.list</field>
        <field name="model">ls.audit.finding.category</field>
        <field name="arch" type="xml">
            <list string="Finding Categories">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="severity"/>
                <field name="response_deadline_days"/>
                <field name="requires_root_cause"/>
                <field name="requires_capa"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ls_audit_finding_category_form" model="ir.ui.view">
        <field name="name">ls.audit.finding.category.form</field>
        <field name="model">ls.audit.finding.category</field>
        <field name="arch" type="xml">
            <form string="Finding Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Major"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="code"/>
                            <field name="severity"/>
                            <field name="sequence"/>
                            <field name="color" widget="integer"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Handling Rules">
                            <field name="response_deadline_days"/>
                            <field name="requires_root_cause"/>
                            <field name="requires_capa"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Definition">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ls_audit_finding_category" model="ir.actions.act_window">
        <field name="name">Finding Categories</field>
        <field name="res_model">ls.audit.finding.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your finding classification</p>
            <p>A category carries the severity, the response deadline and whether a corrective action is mandatory.</p>
        </field>
    </record>

</odoo>
