<odoo>

    <record id="view_ls_audit_response_list" model="ir.ui.view">
        <field name="name">ls.audit.response.list</field>
        <field name="model">ls.audit.response</field>
        <field name="arch" type="xml">
            <list string="Checklist Responses" editable="bottom"
                  decoration-danger="result == 'nonconform'"
                  decoration-warning="result == 'observation'"
                  decoration-muted="result == 'not_applicable'">
                <field name="sequence" widget="handle"/>
                <field name="audit_id" column_invisible="context.get('hide_audit')"/>
                <field name="reference_clause"/>
                <field name="name"/>
                <field name="is_mandatory"/>
                <field name="result"/>
                <field name="evidence"/>
                <field name="auditor_id" readonly="1" optional="show"/>
                <field name="assessment_date" readonly="1" optional="hide"/>
                <field name="finding_id" readonly="1" optional="show"/>
                <button name="action_create_finding" type="object" string="Raise Finding"
                        icon="fa-exclamation-triangle" title="Raise a finding from this question"
                        invisible="finding_id or result not in ('nonconform', 'observation')"/>
            </list>
        </field>
    </record>

    <record id="view_ls_audit_response_form" model="ir.ui.view">
        <field name="name">ls.audit.response.form</field>
        <field name="model">ls.audit.response</field>
        <field name="arch" type="xml">
            <form string="Checklist Response">
                <header>
                    <button name="action_create_finding" type="object" string="Raise Finding"
                            class="btn-primary"
                            invisible="finding_id or result not in ('nonconform', 'observation')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="audit_id"/>
                            <field name="reference_clause"/>
                            <field name="is_mandatory"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="auditor_id"/>
                            <field name="assessment_date"/>
                            <field name="finding_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Question">
                        <field name="name" nolabel="1"/>
                    </group>
                    <group string="Auditor Guidance" invisible="not guidance">
                        <field name="guidance" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Objective Evidence">
                        <field name="evidence" nolabel="1"
                               placeholder="Records examined, people interviewed, observations made."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_audit_response_search" model="ir.ui.view">
        <field name="name">ls.audit.response.search</field>
        <field name="model">ls.audit.response</field>
        <field name="arch" type="xml">
            <search string="Checklist Responses">
                <field name="name" string="Question"/>
                <field name="audit_id"/>
                <field name="reference_clause"/>
                <filter name="filter_pending" string="Pending" domain="[('result', '=', 'pending')]"/>
                <filter name="filter_nonconform" string="Non-conform" domain="[('result', '=', 'nonconform')]"/>
                <filter name="filter_observation" string="Observation" domain="[('result', '=', 'observation')]"/>
                <separator/>
                <filter name="filter_mandatory" string="Mandatory" domain="[('is_mandatory', '=', True)]"/>
                <filter name="filter_no_finding" string="Without Finding" domain="[('finding_id', '=', False)]"/>
                                    <filter name="group_audit" string="Audit" context="{'group_by': 'audit_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_audit_response" model="ir.actions.act_window">
        <field name="name">Checklist Responses</field>
        <field name="res_model">ls.audit.response</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_audit_response_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checklist response yet</p>
            <p>Responses appear once an approved checklist has been loaded into an audit.</p>
        </field>
    </record>

</odoo>
