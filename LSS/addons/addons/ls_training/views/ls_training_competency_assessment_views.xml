<odoo>

    <record id="ls_training_competency_assessment_list_view"
            model="ir.ui.view">
        <field name="name">ls.training.competency.assessment.list</field>
        <field name="model">ls.training.competency.assessment</field>
        <field name="arch" type="xml">
            <list string="Competency Assessments"
                  decoration-success="is_acquired"
                  decoration-muted="state == 'draft'">
                <field name="employee_id"/>
                <field name="competency_id"/>
                <field name="assessor_id"/>
                <field name="date_assessment"/>
                <field name="date_next" optional="show"/>
                <field name="level"/>
                <field name="is_acquired"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ls_training_competency_assessment_form_view"
            model="ir.ui.view">
        <field name="name">ls.training.competency.assessment.form</field>
        <field name="model">ls.training.competency.assessment</field>
        <field name="arch" type="xml">
            <form string="Competency Assessment">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ls_training.group_ls_training_trainer"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group name="subject">
                            <field name="employee_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'confirmed'"/>
                            <field name="competency_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'confirmed'"/>
                            <field name="assessor_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'confirmed'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group name="outcome">
                            <field name="date_assessment"
                                   readonly="state == 'confirmed'"/>
                            <field name="date_next"/>
                            <field name="level"
                                   readonly="state == 'confirmed'"/>
                            <field name="is_acquired"/>
                        </group>
                    </group>
                    <group name="evidence_group" string="Assessment Evidence">
                        <field name="evidence" nolabel="1"
                               readonly="state == 'confirmed'"
                               placeholder="Describe what was observed or reviewed."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ls_training_competency_assessment_search_view"
            model="ir.ui.view">
        <field name="name">ls.training.competency.assessment.search</field>
        <field name="model">ls.training.competency.assessment</field>
        <field name="arch" type="xml">
            <search string="Competency Assessments">
                <field name="employee_id"/>
                <field name="competency_id"/>
                <field name="assessor_id"/>
                <filter name="filter_acquired" string="Acquired"
                        domain="[('is_acquired', '=', True)]"/>
                <filter name="filter_not_acquired" string="Not Acquired"
                        domain="[('is_acquired', '=', False)]"/>
                <separator/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_reassessment_due"
                        string="Reassessment Due"
                        domain="[('date_next', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_mine" string="My Assessments"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                                    <filter name="group_by_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_competency" string="Competency"
                        context="{'group_by': 'competency_id'}"/>
                    <filter name="group_by_level" string="Level"
                        context="{'group_by': 'level'}"/>
            </search>
        </field>
    </record>

    <record id="ls_training_competency_assessment_action"
            model="ir.actions.act_window">
        <field name="name">Competency Assessments</field>
        <field name="res_model">ls.training.competency.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="ls_training_competency_assessment_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first competency assessment
            </p>
            <p>
                An assessment evidences that a named assessor evaluated an
                employee against a defined competency.
            </p>
        </field>
    </record>

</odoo>
