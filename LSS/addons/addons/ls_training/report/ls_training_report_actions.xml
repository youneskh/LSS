<odoo>

    <record id="ls_training_certificate_report_action"
            model="ir.actions.report">
        <field name="name">Training Certificate</field>
        <field name="model">ls.training.certification</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_training.ls_training_certificate_document</field>
        <field name="report_file">ls_training.ls_training_certificate_document</field>
        <field name="binding_model_id"
               ref="model_ls_training_certification"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Certificate - %s' % (object.name)</field>
    </record>

    <record id="ls_training_employee_record_report_action"
            model="ir.actions.report">
        <field name="name">Training Record</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_training.ls_training_employee_record_document</field>
        <field name="report_file">ls_training.ls_training_employee_record_document</field>
        <field name="print_report_name">'Training Record - %s' % (object.name)</field>
    </record>

</odoo>
