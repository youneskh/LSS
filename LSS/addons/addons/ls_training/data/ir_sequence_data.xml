<odoo>
    <data noupdate="1">

        <record id="ls_training_course_sequence" model="ir.sequence">
            <field name="name">Training Course</field>
            <field name="code">ls.training.course</field>
            <field name="prefix">TRN/CRS/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ls_training_session_sequence" model="ir.sequence">
            <field name="name">Training Session</field>
            <field name="code">ls.training.session</field>
            <field name="prefix">TRN/SES/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ls_training_certification_sequence" model="ir.sequence">
            <field name="name">Training Certification</field>
            <field name="code">ls.training.certification</field>
            <field name="prefix">TRN/CER/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
