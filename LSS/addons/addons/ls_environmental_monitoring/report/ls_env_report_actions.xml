<odoo>
    <data>
        <record id="action_report_ls_env_sample" model="ir.actions.report">
            <field name="name">Environmental Monitoring Record</field>
            <field name="model">ls.env.sample</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ls_environmental_monitoring.report_ls_env_sample_document</field>
