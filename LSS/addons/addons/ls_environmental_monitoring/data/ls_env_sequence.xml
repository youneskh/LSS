<odoo>
    <data noupdate="1">

        <record id="seq_ls_env_sample" model="ir.sequence">
            <field name="name">Environmental Monitoring Sample</field>
            <field name="code">ls.env.sample</field>
            <field name="prefix">EM/%(year)s/</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ls_env_excursion" model="ir.sequence">
            <field name="name">Environmental Monitoring Excursion</field>
            <field name="code">ls.env.excursion</field>
            <field name="prefix">EMX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
