<odoo>
    <data>
        <record id="view_ls_env_plan_list" model="ir.ui.view">
            <field name="name">ls.env.plan.list</field>
            <field name="model">ls.env.plan</field>
            <field name="arch" type="xml">
                <list string="Monitoring Plans" decoration-muted="state in ('superseded', 'cancelled')"
                      decoration-info="state == 'draft'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="version"/>
                    <field name="area_id"/>
                    <field name="line_count" string="Lines"/>
                    <field name="effective_date"/>
                    <field name="review_date"/>
                    <field name="state" widget="badge"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_ls_env_plan_form" model="ir.ui.view">
            <field name="name">ls.env.plan.form</field>
            <field name="model">ls.env.plan</field>
            <field name="arch" type="xml">
                <form string="Monitoring Plan">
                    <header>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_create_revision" type="object" string="Create Revision"
                                invisible="state != 'approved'"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,approved,superseded"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Plan title" readonly="state != 'draft'"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" readonly="state != 'draft'"/>
                                <field name="version" readonly="1"/>
                                <field name="area_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="effective_date" readonly="1"/>
                                <field name="review_date"/>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="superseded_by_id" readonly="1" invisible="state != 'superseded'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Plan Lines" name="lines">
                                <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="sampling_point_id"/>
                                        <field name="area_id" readonly="1" optional="show"/>
                                        <field name="parameter_id"/>
                                        <field name="method_id"/>
                                        <field name="occupancy_state"/>
                                        <field name="frequency_interval"/>
                                        <field name="frequency_unit"/>
                                        <field name="start_date"/>
                                        <field name="next_due_date" readonly="1"/>
                                        <field name="responsible_id" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Rationale" name="rationale">
                                <field name="rationale" nolabel="1" readonly="state != 'draft'"
                                       placeholder="Basis for the scope and frequency of this plan."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_ls_env_plan_search" model="ir.ui.view">
            <field name="name">ls.env.plan.search</field>
            <field name="model">ls.env.plan</field>
            <field name="arch" type="xml">
                <search string="Monitoring Plans">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="area_id"/>
                    <filter name="filter_approved" string="In Force" domain="[('state', '=', 'approved')]"/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_review_due" string="Review Due"
                            domain="[('review_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                                            <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_area" string="Area" context="{'group_by': 'area_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_ls_env_plan" model="ir.actions.act_window">
            <field name="name">Monitoring Plans</field>
            <field name="res_model">ls.env.plan</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a monitoring plan</p>
                <p>A plan sets out which parameters are monitored at which points and how often. Only approved plans generate samples.</p>
            </field>
        </record>

    </data>
</odoo>
