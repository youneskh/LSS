<odoo>
    <data>
        <record id="view_ls_env_area_list" model="ir.ui.view">
            <field name="name">ls.env.area.list</field>
            <field name="model">ls.env.area</field>
            <field name="arch" type="xml">
                <list string="Monitored Areas">
                    <field name="complete_name" string="Area"/>
                    <field name="code"/>
                    <field name="grade_id"/>
                    <field name="responsible_id"/>
                    <field name="sampling_point_count" string="Points"/>
                    <field name="open_excursion_count" string="Open Excursions"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_ls_env_area_form" model="ir.ui.view">
            <field name="name">ls.env.area.form</field>
            <field name="model">ls.env.area</field>
            <field name="arch" type="xml">
                <form string="Monitored Area">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_sampling_points" type="object"
                                    class="oe_stat_button" icon="fa-map-marker">
                                <field name="sampling_point_count" widget="statinfo" string="Points"/>
                            </button>
                            <button name="action_view_open_excursions" type="object"
                                    class="oe_stat_button" icon="fa-exclamation-triangle">
                                <field name="open_excursion_count" widget="statinfo" string="Excursions"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Room or suite name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="parent_id"/>
                                <field name="grade_id"/>
                            </group>
                            <group>
                                <field name="responsible_id"/>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Sampling Points" name="points">
                                <field name="sampling_point_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="is_critical"/>
                                        <field name="approved_limit_count" string="Approved Limits"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_ls_env_area_search" model="ir.ui.view">
            <field name="name">ls.env.area.search</field>
            <field name="model">ls.env.area</field>
            <field name="arch" type="xml">
                <search string="Monitored Areas">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="grade_id"/>
                    <filter name="filter_with_excursions" string="With Open Excursions"
                            domain="[('open_excursion_count', '&gt;', 0)]"/>
                                            <filter name="group_grade" string="Grade" context="{'group_by': 'grade_id'}"/>
                    <filter name="group_parent" string="Parent Area" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_ls_env_area" model="ir.actions.act_window">
            <field name="name">Monitored Areas</field>
            <field name="res_model">ls.env.area</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define a monitored area</p>
                <p>Areas are the rooms, suites and zones covered by your monitoring programme.</p>
            </field>
        </record>

    </data>
</odoo>
