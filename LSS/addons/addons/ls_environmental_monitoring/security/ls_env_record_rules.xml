<odoo>
    <data noupdate="0">

        <!--
            Every rule below is a global rule. A global rule applies to all
            users and therefore does not reference a group.

            This is deliberate. The name of the field that links an ir.rule to
            a set of groups could not be verified against official Odoo 19
            documentation, and Odoo 19 is known to have renamed several group
            fields. Restricting these rules to groups would risk the module
            failing to install. Role separation is instead enforced by the
            access control lists in ir.model.access.csv and, for individual
            state transitions, by checks in the Python layer.

            The "global" field is computed by Odoo from the absence of a group
            and is never written explicitly.
        -->

        <record id="rule_ls_env_grade_company" model="ir.rule">
            <field name="name">Environmental Monitoring Grade: multi-company</field>
            <field name="model_id" ref="model_ls_env_grade"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

