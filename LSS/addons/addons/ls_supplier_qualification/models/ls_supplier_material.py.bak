"""Qualified scope: the materials and services a supplier is approved for."""
from odoo import _, api, fields, models
from odoo.exceptions import UserError, ValidationError

MATERIAL_TYPE_SELECTION = [
    ("api", "Active Pharmaceutical Ingredient"),
    ("excipient", "Excipient"),
    ("raw_material", "Other Raw Material"),
    ("primary_packaging", "Primary Packaging Material"),
    ("secondary_packaging", "Secondary Packaging Material"),
    ("component", "Component or Sub-Assembly"),
    ("consumable", "Consumable"),
    ("service", "Service"),
    ("subcontracting", "Subcontracted Operation"),
    ("equipment", "Equipment"),
]

MATERIAL_STATE_SELECTION = [
    ("draft", "Under Qualification"),
    ("qualified", "Qualified"),
    ("suspended", "Suspended"),
    ("rejected", "Rejected"),
]


class LsSupplierMaterial(models.Model):
    """One material or service a supplier is qualified to supply.

    A dossier without at least one qualified line cannot be submitted for
    approval: the approval scope must always be explicit.
    """

    _name = "ls.supplier.material"
    _description = "Life Sciences Supplier Qualified Material or Service"
    _inherit = ["mail.thread"]
    _order = "qualification_id, sequence, id"
    _check_company_auto = True

    name = fields.Char(
        string="Designation",
        required=True,
        tracking=True,
        help="Designation of the material or service as used by the quality "
             "department. It is independent of the product catalogue so that "
             "non-catalogued items can be qualified.",
    )
    sequence = fields.Integer(default=10)
    qualification_id = fields.Many2one(
        comodel_name="ls.supplier.qualification",
        required=True,
        ondelete="cascade",
        index=True,
    )
    partner_id = fields.Many2one(
        related="qualification_id.partner_id",
        store=True,
        index=True,
    )
    company_id = fields.Many2one(
        related="qualification_id.company_id",
        store=True,
        index=True,
    )
    product_id = fields.Many2one(
        comodel_name="product.product",
        string="Catalogue Product",
        ondelete="restrict",
        check_company=True,
        tracking=True,
        help="Optional link to the product catalogue. When set, the purchase "
             "scope control can verify that purchase order lines stay inside "
             "the qualified scope.",
    )
    material_type = fields.Selection(
        selection=MATERIAL_TYPE_SELECTION,
        required=True,
        default="raw_material",
        tracking=True,
    )
    specification_reference = fields.Char(
        help="Reference of the internal specification the supplier must meet.",
    )
    manufacturing_site = fields.Char(
        help="Site where the material is manufactured, when it differs from "
             "the supplier address.",
    )
    evaluated_batches = fields.Char(
        help="Batch or lot numbers evaluated during qualification.",
    )
    state = fields.Selection(
        selection=MATERIAL_STATE_SELECTION,
        required=True,
        default="draft",
        tracking=True,
        index=True,
    )
    qualification_date = fields.Date(tracking=True)
    expiry_date = fields.Date(
        string="Scope Valid Until",
        tracking=True,
        help="Optional end of validity specific to this material. When empty, "
             "the validity of the dossier applies.",
    )
    is_expired = fields.Boolean(compute="_compute_is_expired")
    suspension_reason = fields.Text(readonly=True)
    notes = fields.Text()

    _sql_constraints = [
        (
            "product_qualification_uniq",
            "UNIQUE(qualification_id, product_id)",
            "A catalogue product can only appear once in a given dossier.",
        ),
    ]

    @api.depends("expiry_date", "state")
    def _compute_is_expired(self):
        """Flag qualified lines whose own validity has elapsed."""
        today = fields.Date.context_today(self)
        for record in self:
            record.is_expired = bool(
                record.state == "qualified"
                and record.expiry_date
                and record.expiry_date < today
            )

    @api.constrains("qualification_date", "expiry_date")
    def _check_dates(self):
        """The scope expiry must be after the qualification date."""
        for record in self:
            if (
                record.qualification_date
                and record.expiry_date
                and record.expiry_date <= record.qualification_date
            ):
                raise ValidationError(
                    _("Scope line '%s': the validity end date must be after "
                      "the qualification date.", record.name)
                )

    @api.constrains("state", "qualification_date")
    def _check_qualification_date(self):
        """A qualified line must carry its qualification date."""
        for record in self:
            if record.state == "qualified" and not record.qualification_date:
                raise ValidationError(
                    _("Scope line '%s' is qualified: the qualification date "
                      "is required.", record.name)
                )

    @api.onchange("product_id")
    def _onchange_product_id(self):
        """Propose the product name as the scope designation."""
        for record in self:
            if record.product_id and not record.name:
                record.name = record.product_id.display_name

    def action_qualify(self):
        """Mark the scope line as qualified."""
        for record in self:
            if record.state not in ("draft", "suspended"):
                raise UserError(
                    _("Scope line '%s' cannot be qualified from its current "
                      "status.", record.name)
                )
            record.write({
                "state": "qualified",
                "qualification_date": (
                    record.qualification_date
                    or fields.Date.context_today(record)
                ),
                "suspension_reason": False,
            })
            record.message_post(body=_("Material or service qualified."))
        return True

    def action_suspend(self):
        """Suspend a qualified scope line."""
        for record in self:
            if record.state != "qualified":
                raise UserError(
                    _("Only a qualified scope line can be suspended "
                      "(line '%s').", record.name)
                )
            record.state = "suspended"
            record.message_post(body=_("Material or service suspended."))
        return True

    def action_reject(self):
        """Reject a scope line that failed qualification."""
        for record in self:
            if record.state == "rejected":
                continue
            record.state = "rejected"
            record.message_post(body=_("Material or service rejected."))
        return True

    def action_reset_to_draft(self):
        """Return a scope line to the under-qualification status."""
        for record in self:
            record.state = "draft"
            record.message_post(body=_("Scope line reset to draft."))
        return True

    @api.model
    def _cron_check_material_expiry(self):
        """Suspend qualified scope lines whose own validity has elapsed.

        :return: number of scope lines suspended.
        :rtype: int
        """
        today = fields.Date.context_today(self)
        expired = self.search([
            ("state", "=", "qualified"),
            ("expiry_date", "!=", False),
            ("expiry_date", "<", today),
        ])
        for record in expired:
            record.write({
                "state": "suspended",
                "suspension_reason": _(
                    "Scope validity elapsed on %s.", record.expiry_date
                ),
            })
            record.message_post(body=_(
                "Scope validity elapsed on %s: the line is suspended.",
                record.expiry_date,
            ))
        return len(expired)
