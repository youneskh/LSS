"""Supplier categories drive the qualification rules applied to a supplier."""
from odoo import _, api, fields, models
from odoo.exceptions import ValidationError

CRITICALITY_SELECTION = [
    ("critical", "Critical"),
    ("major", "Major"),
    ("minor", "Minor"),
]


class LsSupplierCategory(models.Model):
    """Category of supplier (for example 'API manufacturer').

    The category carries the organisation's own rules: whether an assessment
    is mandatory, whether an audit is mandatory, and the periodicity of
    requalification, audit and performance review. These values are
    configuration data owned by the quality department, not defaults derived
    from any regulation.
    """

    _name = "ls.supplier.category"
    _description = "Life Sciences Supplier Category"
    _order = "sequence, name"

    name = fields.Char(required=True, translate=True)
    code = fields.Char(required=True)
    sequence = fields.Integer(default=10)
    active = fields.Boolean(default=True)
    description = fields.Text(translate=True)
    criticality = fields.Selection(
        selection=CRITICALITY_SELECTION,
        required=True,
        default="major",
        help="Default criticality applied to suppliers of this category. "
             "It can be overridden on each qualification dossier.",
    )
    requires_assessment = fields.Boolean(
        default=True,
        help="A completed assessment is required before the dossier can be "
             "submitted for approval.",
    )
    requires_initial_audit = fields.Boolean(
        default=False,
        help="A closed audit is required before the dossier can be submitted "
             "for approval.",
    )
    requires_periodic_audit = fields.Boolean(
        default=False,
        help="A recurring audit is planned after each approval.",
    )
    audit_interval_months = fields.Integer(
        default=36,
        help="Number of months between two periodic audits.",
    )
    requalification_interval_months = fields.Integer(
        default=36,
        required=True,
        help="Validity of the approval, in months, counted from the approval "
             "date.",
    )
    review_interval_months = fields.Integer(
        default=12,
        required=True,
        help="Number of months between two periodic supplier reviews.",
    )
    standard_ids = fields.Many2many(
        comodel_name="ls.supplier.standard",
        relation="ls_supplier_category_standard_rel",
        column1="category_id",
        column2="standard_id",
        string="Applicable Frameworks",
        help="Frameworks the organisation applies when qualifying suppliers "
             "of this category.",
    )
    company_id = fields.Many2one(
        comodel_name="res.company",
        required=True,
        default=lambda self: self.env.company,
        index=True,
    )
    qualification_ids = fields.One2many(
        comodel_name="ls.supplier.qualification",
        inverse_name="category_id",
        string="Qualification Dossiers",
    )
    qualification_count = fields.Integer(
        compute="_compute_qualification_count",
        string="Dossiers",
    )

    _sql_constraints = [
        (
            "code_company_uniq",
            "UNIQUE(code, company_id)",
            "The supplier category code must be unique per company.",
        ),
    ]

    @api.depends("qualification_ids")
    def _compute_qualification_count(self):
        """Count the dossiers attached to each category."""
        data = self.env["ls.supplier.qualification"]._read_group(
            domain=[("category_id", "in", self.ids)],
            groupby=["category_id"],
            aggregates=["__count"],
        )
        mapped = {category.id: count for category, count in data}
        for record in self:
            record.qualification_count = mapped.get(record.id, 0)

    @api.constrains(
        "requalification_interval_months",
        "review_interval_months",
        "audit_interval_months",
    )
    def _check_intervals(self):
        """Intervals must be strictly positive month counts."""
        for record in self:
            if record.requalification_interval_months <= 0:
                raise ValidationError(
                    _("The requalification interval of category '%s' must be "
                      "strictly positive.", record.name)
                )
            if record.review_interval_months <= 0:
                raise ValidationError(
                    _("The review interval of category '%s' must be strictly "
                      "positive.", record.name)
                )
            if record.requires_periodic_audit and record.audit_interval_months <= 0:
                raise ValidationError(
                    _("Category '%s' requires periodic audits, so the audit "
                      "interval must be strictly positive.", record.name)
                )

    def action_view_qualifications(self):
        """Open the dossiers linked to this category."""
        self.ensure_one()
        action = self.env["ir.actions.act_window"]._for_xml_id(
            "ls_supplier_qualification.action_ls_supplier_qualification"
        )
        action["domain"] = [("category_id", "=", self.id)]
        action["context"] = {"default_category_id": self.id}
        return action
