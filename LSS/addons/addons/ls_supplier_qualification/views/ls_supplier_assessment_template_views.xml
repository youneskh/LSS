<odoo>

    <record id="ls_supplier_assessment_template_view_list" model="ir.ui.view">
        <field name="name">ls.supplier.assessment.template.list</field>
        <field name="model">ls.supplier.assessment.template</field>
        <field name="arch" type="xml">
            <list string="Assessment Templates">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="line_count"/>
                <field name="max_score_per_criterion"/>
                <field name="mandatory_min_score"/>
                <field name="pass_threshold"/>
                <field name="conditional_threshold"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ls_supplier_assessment_template_view_form" model="ir.ui.view">
        <field name="name">ls.supplier.assessment.template.form</field>
        <field name="model">ls.supplier.assessment.template</field>
        <field name="arch" type="xml">
            <form string="Assessment Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Scoring Rules">
                            <field name="max_score_per_criterion"/>
                            <field name="mandatory_min_score"/>
                            <field name="pass_threshold"/>
                            <field name="conditional_threshold"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The scoring rules above are copied onto each assessment
                        when it is created. Changing them later never alters an
                        assessment that has already been performed.
                    </div>
                    <group string="Intended Supplier Categories">
                        <field name="category_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Criteria" name="criteria">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="criterion_id"/>
                                    <field name="weight"/>
                                    <field name="is_mandatory"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                            <field name="line_count" invisible="1"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ls_supplier_assessment_template" model="ir.actions.act_window">
        <field name="name">Assessment Templates</field>
        <field name="res_model">ls.supplier.assessment.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build an assessment template</p>
            <p>
                A template is a questionnaire: a set of weighted criteria plus
                the scale and the thresholds used to conclude Pass,
                Conditional or Fail.
            </p>
        </field>
    </record>

</odoo>
