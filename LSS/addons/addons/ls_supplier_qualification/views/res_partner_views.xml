<odoo>

    <record id="res_partner_view_form_ls_supplier" model="ir.ui.view">
        <field name="name">res.partner.form.ls.supplier.qualification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ls_qualifications" type="object"
                        class="oe_stat_button" icon="fa-certificate"
                        groups="ls_supplier_qualification.group_ls_supplier_viewer">
                    <field name="ls_qualification_count" widget="statinfo"
                           string="Qualification"/>
                </button>
            </div>
            <xpath expr="//sheet/group" position="before">
                <div class="alert alert-success" role="alert"
                     invisible="not ls_is_approved_supplier"
                     groups="ls_supplier_qualification.group_ls_supplier_viewer">
                    Approved supplier until
                    <field name="ls_qualification_expiry_date" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="ls_is_approved_supplier or not ls_qualification_state"
                     groups="ls_supplier_qualification.group_ls_supplier_viewer">
                    Supplier qualification status:
                    <field name="ls_qualification_state" readonly="1" nolabel="1"/>
                </div>
                <field name="ls_is_approved_supplier" invisible="1"
                       groups="ls_supplier_qualification.group_ls_supplier_viewer"/>
                <field name="ls_qualification_id" invisible="1"
                       groups="ls_supplier_qualification.group_ls_supplier_viewer"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search_ls_supplier" model="ir.ui.view">
        <field name="name">res.partner.search.ls.supplier.qualification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_ls_approved_supplier" string="Approved Supplier"
                        domain="[('ls_is_approved_supplier', '=', True)]"
                        groups="ls_supplier_qualification.group_ls_supplier_viewer"/>
            </xpath>
        </field>
    </record>

</odoo>
