<odoo>

    <record id="ls_supplier_qualification_view_list" model="ir.ui.view">
        <field name="name">ls.supplier.qualification.list</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="arch" type="xml">
            <list string="Qualification Dossiers"
                  decoration-danger="state in ['suspended', 'disqualified', 'expired'] or open_critical_finding_count &gt; 0"
                  decoration-warning="expiry_status == 'expiring' or state == 'conditional'"
                  decoration-success="state == 'approved' and expiry_status == 'valid'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="criticality" widget="badge"
                       decoration-danger="criticality == 'critical'"
                       decoration-warning="criticality == 'major'"/>
                <field name="responsible_id" optional="show"/>
                <field name="latest_assessment_score" optional="hide"/>
                <field name="latest_performance_rating" optional="hide"/>
                <field name="open_critical_finding_count" optional="hide"/>
                <field name="risk_level" widget="badge"
                       decoration-danger="risk_level == 'high'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-success="risk_level == 'low'"
                       optional="show"/>
                <field name="approval_date" optional="hide"/>
                <field name="expiry_date" optional="show"/>
                <field name="days_to_expiry" optional="hide"/>
                <field name="next_audit_date" optional="hide"/>
                <field name="next_review_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ['approved']"
                       decoration-warning="state == 'conditional'"
                       decoration-danger="state in ['suspended', 'disqualified', 'expired']"/>
                <field name="expiry_status" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ls_supplier_qualification_view_kanban" model="ir.ui.view">
        <field name="name">ls.supplier.qualification.kanban</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state"/>
                <field name="expiry_status"/>
                <field name="risk_level"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="partner_id"/>
                            </strong>
                            <div class="text-muted">
                                <field name="name"/> - <field name="category_id"/>
                            </div>
                            <div class="mt-1">
                                <field name="criticality" widget="badge"
                                       decoration-danger="criticality == 'critical'"
                                       decoration-warning="criticality == 'major'"/>
                                <field name="risk_level" widget="badge"
                                       decoration-danger="risk_level == 'high'"
                                       decoration-warning="risk_level == 'medium'"
                                       decoration-success="risk_level == 'low'"/>
                            </div>
                            <div class="mt-1" invisible="not expiry_date">
                                Valid until <field name="expiry_date"/>
                            </div>
                            <div class="mt-1 text-danger"
                                 invisible="open_critical_finding_count == 0">
                                <field name="open_critical_finding_count"/>
                                open critical finding(s)
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ls_supplier_qualification_view_form" model="ir.ui.view">
        <field name="name">ls.supplier.qualification.form</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="arch" type="xml">
            <form string="Qualification Dossier">
                <header>
                    <button name="action_start_assessment" type="object"
                            string="Start Assessment" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_audit" type="object"
                            string="Start Audit"
                            invisible="state not in ['assessment', 'approval']"/>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval" class="btn-primary"
                            invisible="state not in ['assessment', 'audit']"/>
                    <button name="action_open_approve_wizard" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'approval'"
                            groups="ls_supplier_qualification.group_ls_supplier_manager"/>
                    <button name="action_open_status_wizard" type="object"
                            string="Change Status"
                            invisible="state not in ['approved', 'conditional', 'suspended']"
                            groups="ls_supplier_qualification.group_ls_supplier_manager"/>
                    <button name="action_requalify" type="object"
                            string="Requalify" class="btn-primary"
                            invisible="state not in ['expired', 'suspended']"
                            groups="ls_supplier_qualification.group_ls_supplier_manager"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ['assessment', 'audit', 'approval']"
                            groups="ls_supplier_qualification.group_ls_supplier_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,assessment,audit,approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_materials" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="material_count" widget="statinfo" string="Scope"/>
                        </button>
                        <button name="action_view_assessments" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="assessment_count" widget="statinfo"
                                   string="Assessments"/>
                        </button>
                        <button name="action_view_audits" type="object"
                                class="oe_stat_button" icon="fa-search">
                            <field name="audit_count" widget="statinfo" string="Audits"/>
                        </button>
                        <button name="action_view_performances" type="object"
                                class="oe_stat_button" icon="fa-line-chart">
                            <field name="performance_count" widget="statinfo"
                                   string="Performance"/>
                        </button>
                        <button name="action_view_reviews" type="object"
                                class="oe_stat_button" icon="fa-refresh">
                            <field name="review_count" widget="statinfo" string="Reviews"/>
                        </button>
                        <button name="action_view_signatures" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="signature_count" widget="statinfo"
                                   string="Signatures"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Expired"
                            bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Disqualified"
                            bg_color="text-bg-danger" invisible="state != 'disqualified'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'suspended'">
                        This supplier is suspended.
                        <field name="suspension_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'disqualified'">
                        This supplier is disqualified.
                        <field name="disqualification_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ['assessment', 'audit'] or is_ready_for_approval">
                        <strong>Not ready for approval yet:</strong>
                        <field name="blocking_reasons" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Supplier">
                            <field name="partner_id"
                                   readonly="state not in ['draft', 'assessment']"/>
                            <field name="category_id"
                                   readonly="state not in ['draft', 'assessment']"/>
                            <field name="criticality"/>
                            <field name="responsible_id"/>
                            <field name="active" invisible="1"/>
                            <field name="is_ready_for_approval" invisible="1"/>
                            <field name="expiry_status" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity">
                            <field name="registration_date"/>
                            <field name="approval_date"/>
                            <field name="approved_by_id"/>
                            <field name="requalification_interval_months"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"
                                   invisible="state not in ['approved', 'conditional']"/>
                            <field name="next_audit_date"/>
                            <field name="next_review_date"/>
                        </group>
                    </group>
                    <group string="Approval Conditions"
                           invisible="not approval_conditions">
                        <field name="approval_conditions" nolabel="1" readonly="1"/>
                    </group>
                    <group>
                        <group string="Indicators">
                            <field name="risk_level" widget="badge"
                                   decoration-danger="risk_level == 'high'"
                                   decoration-warning="risk_level == 'medium'"
                                   decoration-success="risk_level == 'low'"/>
                            <field name="latest_assessment_id"/>
                            <field name="latest_assessment_score" widget="percentage"/>
                            <field name="latest_assessment_result"/>
                        </group>
                        <group string="Monitoring">
                            <field name="latest_performance_score"/>
                            <field name="latest_performance_rating"/>
                            <field name="open_critical_finding_count"/>
                            <field name="open_major_finding_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Qualified Scope" name="scope">
                            <field name="material_ids"
                                   context="{'default_qualification_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="material_type"/>
                                    <field name="specification_reference" optional="hide"/>
                                    <field name="qualification_date"/>
                                    <field name="expiry_date"/>
                                    <field name="state"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assessments" name="assessments">
                            <field name="assessment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="assessment_type"/>
                                    <field name="assessor_id"/>
                                    <field name="score_percent"/>
                                    <field name="result"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audits" name="audits">
                            <field name="audit_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="planned_date"/>
                                    <field name="audit_type"/>
                                    <field name="lead_auditor_id"/>
                                    <field name="critical_count"/>
                                    <field name="major_count"/>
                                    <field name="outcome"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Performance" name="performance">
                            <field name="performance_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="overall_score"/>
                                    <field name="rating"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reviews" name="reviews">
                            <field name="review_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="review_date"/>
                                    <field name="reviewer_id"/>
                                    <field name="decision"/>
                                    <field name="new_expiry_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signature Log" name="signatures">
                            <field name="signature_ids" readonly="1">
                                <list>
                                    <field name="sequence_number"/>
                                    <field name="signed_on"/>
                                    <field name="user_id"/>
                                    <field name="meaning"/>
                                    <field name="signed_record_name"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ls_supplier_qualification_view_search" model="ir.ui.view">
        <field name="name">ls.supplier.qualification.search</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="arch" type="xml">
            <search string="Qualification Dossiers">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="responsible_id"/>
                <filter name="filter_mine" string="My Dossiers"
                        domain="[('responsible_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', 'in', ['approved', 'conditional'])]"/>
                <filter name="filter_in_progress" string="In Qualification"
                        domain="[('state', 'in', ['draft', 'assessment', 'audit', 'approval'])]"/>
                <filter name="filter_pending_approval" string="Pending Approval"
                        domain="[('state', '=', 'approval')]"/>
                <filter name="filter_not_approved" string="Not Approved"
                        domain="[('state', 'in', ['suspended', 'expired', 'disqualified'])]"/>
                <separator/>
                <filter name="filter_expiring" string="Expiring Soon"
                        domain="[('expiry_status', '=', 'expiring')]"/>
                <filter name="filter_high_risk" string="High Risk"
                        domain="[('risk_level', '=', 'high')]"/>
                <filter name="filter_critical_findings" string="Open Critical Findings"
                        domain="[('open_critical_finding_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_audit_due" string="Audit Due"
                        domain="[('next_audit_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_review_due" string="Review Due"
                        domain="[('next_review_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                                    <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Category"
                        context="{'group_by': 'category_id'}"/>
                    <filter name="group_criticality" string="Criticality"
                        context="{'group_by': 'criticality'}"/>
                    <filter name="group_risk" string="Risk Level"
                        context="{'group_by': 'risk_level'}"/>
                    <filter name="group_responsible" string="Responsible"
                        context="{'group_by': 'responsible_id'}"/>
                    <filter name="group_expiry" string="Validity End"
                        context="{'group_by': 'expiry_date'}"/>
            </search>
        </field>
    </record>

    <record id="ls_supplier_qualification_view_graph" model="ir.ui.view">
        <field name="name">ls.supplier.qualification.graph</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="arch" type="xml">
            <graph string="Qualification Overview" type="bar" sample="1">
                <field name="category_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="ls_supplier_qualification_view_pivot" model="ir.ui.view">
        <field name="name">ls.supplier.qualification.pivot</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="arch" type="xml">
            <pivot string="Qualification Analysis" sample="1">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="latest_assessment_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ls_supplier_qualification" model="ir.actions.act_window">
        <field name="name">Qualification Dossiers</field>
        <field name="res_model">ls.supplier.qualification</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open a qualification dossier</p>
            <p>
                The dossier follows a supplier from registration through
                assessment, audit and approval, and then through performance
                monitoring and periodic review.
            </p>
        </field>
    </record>

    <record id="action_ls_supplier_qualification_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Approvals</field>
        <field name="res_model">ls.supplier.qualification</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_expiring': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval expires soon</p>
            <p>
                Dossiers appear here when the end of validity falls within the
                reminder lead time configured for the company.
            </p>
        </field>
    </record>

</odoo>
