<odoo>

    <record id="res_config_settings_view_form_ls_supplier" model="ir.ui.view">
        <field name="name">res.config.settings.form.ls.supplier.qualification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Supplier Qualification"
                     name="ls_supplier_qualification"
                     groups="ls_supplier_qualification.group_ls_supplier_manager">
                    <block title="Governance" name="ls_governance">
                        <setting id="ls_setting_sod" string="Segregation of Duties"
                                 help="Prevent an assessor or a lead auditor from approving the dossier they contributed to, and prevent an assessment from being reviewed by its own assessor.">
                            <field name="ls_enforce_sod"/>
                        </setting>
                        <setting id="ls_setting_reminder" string="Expiry Reminder"
                                 help="Number of days before an end of validity at which the scheduled actions raise reminders.">
                            <field name="ls_expiry_reminder_days"/>
                        </setting>
                        <setting id="ls_setting_audit_response" string="Audit Response Lead Time"
                                 help="Default number of days granted to a supplier to answer an issued audit report.">
                            <field name="ls_audit_response_days"/>
                        </setting>
                    </block>
                    <block title="Purchase Control" name="ls_purchase">
                        <setting id="ls_setting_po_control" string="Purchase Order Control"
                                 help="Behaviour when a purchase order is confirmed for a supplier that is not approved.">
                            <field name="ls_po_control_level"/>
                        </setting>
                        <setting id="ls_setting_po_scope" string="Check Qualified Scope"
                                 help="Also verify that each ordered product belongs to the qualified scope of the supplier.">
                            <field name="ls_po_check_scope"/>
                        </setting>
                    </block>
                    <block title="Performance Scorecard" name="ls_performance">
                        <setting id="ls_setting_weights" string="Indicator Weights"
                                 help="Relative weights combined into the overall performance score. They are frozen on each evaluation at creation.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="ls_perf_weight_otd" class="col-lg-6"/>
                                    <field name="ls_perf_weight_otd"/>
                                </div>
                                <div class="row">
                                    <label for="ls_perf_weight_quality" class="col-lg-6"/>
                                    <field name="ls_perf_weight_quality"/>
                                </div>
                                <div class="row">
                                    <label for="ls_perf_weight_documentation" class="col-lg-6"/>
                                    <field name="ls_perf_weight_documentation"/>
                                </div>
                                <div class="row">
                                    <label for="ls_perf_weight_responsiveness" class="col-lg-6"/>
                                    <field name="ls_perf_weight_responsiveness"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="ls_setting_thresholds" string="Rating Thresholds"
                                 help="Overall score at or above which a supplier is rated A, B or C. Below the C threshold the rating is D.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="ls_perf_threshold_a" class="col-lg-6"/>
                                    <field name="ls_perf_threshold_a"/>
                                </div>
                                <div class="row">
                                    <label for="ls_perf_threshold_b" class="col-lg-6"/>
                                    <field name="ls_perf_threshold_b"/>
                                </div>
                                <div class="row">
                                    <label for="ls_perf_threshold_c" class="col-lg-6"/>
                                    <field name="ls_perf_threshold_c"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
