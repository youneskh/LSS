     Starter categories. The criticality levels and the intervals below are
     PROPOSALS chosen by this module to give a working configuration on
     day one. They are not taken from any regulation. Each organisation must
     review and approve them as part of its own quality system before use.
-->
<odoo noupdate="1">

    <record id="category_api_manufacturer" model="ls.supplier.category">
        <field name="name">Active Substance Manufacturer</field>
        <field name="code">API</field>
        <field name="criticality">critical</field>
        <field name="requires_assessment" eval="True"/>
        <field name="requires_initial_audit" eval="True"/>
        <field name="requires_periodic_audit" eval="True"/>
        <field name="audit_interval_months">36</field>
        <field name="requalification_interval_months">36</field>
        <field name="review_interval_months">12</field>
        <field name="sequence">10</field>
    </record>

    <record id="category_excipient_supplier" model="ls.supplier.category">
        <field name="name">Excipient Supplier</field>
        <field name="code">EXC</field>
        <field name="criticality">major</field>
        <field name="requires_assessment" eval="True"/>
        <field name="requires_initial_audit" eval="False"/>
        <field name="requires_periodic_audit" eval="False"/>
        <field name="requalification_interval_months">36</field>
        <field name="review_interval_months">12</field>
        <field name="sequence">20</field>
    </record>

