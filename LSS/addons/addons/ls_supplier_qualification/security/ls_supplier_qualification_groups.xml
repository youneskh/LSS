<odoo>

    <!--
        Odoo 19 replaced res.groups.category_id with res.groups.privilege_id,
        which points at the new res.groups.privilege model. The module
        category is carried by the privilege record instead of the group.
    -->
    <record id="module_category_ls_supplier_qualification" model="ir.module.category">
        <field name="name">Supplier Qualification</field>
        <field name="description">Life Sciences supplier qualification, assessment, audit and performance management.</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_ls_supplier_qualification" model="res.groups.privilege">
        <field name="name">Supplier Qualification</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ls_supplier_qualification"/>
    </record>

    <record id="group_ls_supplier_viewer" model="res.groups">
        <field name="name">Supplier Viewer</field>
        <field name="privilege_id" ref="privilege_ls_supplier_qualification"/>
        <field name="comment">Read-only access to supplier qualification dossiers, assessments, audits, performance evaluations and reviews.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ls_supplier_assessor" model="res.groups">
        <field name="name">Supplier Assessor</field>
        <field name="privilege_id" ref="privilege_ls_supplier_qualification"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_supplier_viewer'))]"/>
        <field name="comment">Creates and conducts assessments, audits and performance evaluations. Cannot approve, suspend or disqualify a supplier, and cannot delete records.</field>
    </record>

    <record id="group_ls_supplier_manager" model="res.groups">
        <field name="name">Supplier Manager</field>
        <field name="privilege_id" ref="privilege_ls_supplier_qualification"/>
        <field name="implied_ids" eval="[(4, ref('group_ls_supplier_assessor'))]"/>
        <field name="comment">Full access: configuration, approval, suspension, disqualification and periodic review decisions.</field>
    </record>

    <!--
        No group is granted automatically to new users. Assignment is an
        explicit administrative act, documented in
        doc/09_administrator_manual.md, so that access to qualification data
        is always traceable to a decision.
    -->

</odoo>
