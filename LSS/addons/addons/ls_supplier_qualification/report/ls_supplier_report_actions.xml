<odoo>

    <record id="action_report_ls_supplier_qualification" model="ir.actions.report">
        <field name="name">Supplier Qualification Dossier</field>
        <field name="model">ls.supplier.qualification</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_supplier_qualification.report_ls_supplier_qualification</field>
        <field name="report_file">ls_supplier_qualification.report_ls_supplier_qualification</field>
        <field name="binding_model_id" ref="model_ls_supplier_qualification"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s - %s' % (object.name, object.partner_id.display_name)</field>
    </record>

    <record id="action_report_ls_supplier_assessment" model="ir.actions.report">
        <field name="name">Supplier Assessment Report</field>
        <field name="model">ls.supplier.assessment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_supplier_qualification.report_ls_supplier_assessment</field>
        <field name="report_file">ls_supplier_qualification.report_ls_supplier_assessment</field>
        <field name="binding_model_id" ref="model_ls_supplier_assessment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s - %s' % (object.name, object.partner_id.display_name)</field>
    </record>

    <record id="action_report_ls_supplier_audit" model="ir.actions.report">
        <field name="name">Supplier Audit Report</field>
        <field name="model">ls.supplier.audit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_supplier_qualification.report_ls_supplier_audit</field>
        <field name="report_file">ls_supplier_qualification.report_ls_supplier_audit</field>
        <field name="binding_model_id" ref="model_ls_supplier_audit"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'%s - %s' % (object.name, object.partner_id.display_name)</field>
    </record>

</odoo>
