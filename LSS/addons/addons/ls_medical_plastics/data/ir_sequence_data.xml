<odoo>
    <data noupdate="1">

        <record id="seq_mp_tool" model="ir.sequence">
            <field name="name">Medical Plastics Tool</field>
            <field name="code">ls.mp.tool</field>
            <field name="prefix">TOOL/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_mp_tool_maintenance" model="ir.sequence">
            <field name="name">Medical Plastics Tool Maintenance</field>
            <field name="code">ls.mp.tool.maintenance</field>
            <field name="prefix">TM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_mp_molding_parameter" model="ir.sequence">
            <field name="name">Medical Plastics Moulding Parameter Specification</field>
            <field name="code">ls.mp.molding_parameter</field>
            <field name="prefix">MPS/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_mp_injection_molding" model="ir.sequence">
            <field name="name">Medical Plastics Moulding Run</field>
            <field name="code">ls.mp.injection_molding</field>
            <field name="prefix">IM/%(year)s/</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
