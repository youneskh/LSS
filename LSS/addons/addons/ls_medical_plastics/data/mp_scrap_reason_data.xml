<odoo>
    <data noupdate="1">

        <!--
          Default scrap reason catalogue.

          The reason names are standard injection moulding defect terminology.
          They are a configurable starting point, not a regulatory or
          normative classification, and each site is expected to adapt the
          catalogue to its own defect taxonomy.

          Reasons are created without a company so that they are shared across
          all companies until a site chooses to restrict them.
        -->

        <record id="mp_scrap_reason_startup_purge" model="ls.mp.scrap.reason">
            <field name="name">Start-up purge</field>
            <field name="code">SU-PURGE</field>
            <field name="category">setup</field>
            <field name="sequence">10</field>
            <field name="is_startup" eval="True"/>
            <field name="requires_investigation" eval="False"/>
            <field name="description">Material purged from the barrel before stable production is reached.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="mp_scrap_reason_startup_stabilisation" model="ls.mp.scrap.reason">
            <field name="name">Start-up stabilisation parts</field>
            <field name="code">SU-STAB</field>
            <field name="category">setup</field>
            <field name="sequence">20</field>
            <field name="is_startup" eval="True"/>
            <field name="requires_investigation" eval="False"/>
            <field name="description">Parts produced while the process is being brought to a stable condition.</field>
            <field name="company_id" eval="False"/>
        </record>

