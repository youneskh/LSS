<odoo>

    <record id="view_mp_molding_parameter_list" model="ir.ui.view">
        <field name="name">ls.mp.molding_parameter.list</field>
        <field name="model">ls.mp.molding_parameter</field>
        <field name="arch" type="xml">
            <list string="Moulding Parameter Specifications"
                  decoration-success="state == 'approved'"
                  decoration-muted="state in ('superseded', 'obsolete', 'cancelled')"
                  decoration-danger="review_overdue">
                <field name="name"/>
                <field name="component_id"/>
                <field name="tool_id"/>
                <field name="workcenter_id" optional="show"/>
                <field name="version"/>
                <field name="parameter_count"/>
                <field name="critical_parameter_count"/>
                <field name="effective_date"/>
                <field name="next_review_date" optional="show"/>
                <field name="review_overdue" optional="hide"/>
                <field name="approver_id" optional="hide"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mp_molding_parameter_form" model="ir.ui.view">
        <field name="name">ls.mp.molding_parameter.form</field>
        <field name="model">ls.mp.molding_parameter</field>
        <field name="arch" type="xml">
            <form string="Moulding Parameter Specification">
                <header>
                    <button name="action_submit_for_review" type="object"
                            string="Submit For Review" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Record Review"
                            class="btn-primary"
                            invisible="state != 'review' or reviewer_id"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            groups="ls_medical_plastics.group_mp_manager"
                            invisible="state != 'review' or not reviewer_id"/>
                    <button name="action_reject" type="object" string="Return To Draft"
                            invisible="state != 'review'"/>
                    <button name="action_create_new_version" type="object"
                            string="New Version"
                            invisible="state not in ('approved', 'superseded', 'obsolete')"/>
                    <button name="action_set_obsolete" type="object" string="Set Obsolete"
                            groups="ls_medical_plastics.group_mp_manager"
                            invisible="state not in ('approved', 'superseded')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'review')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_runs" type="object"
                                class="oe_stat_button" icon="fa-industry">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-warning"
                            invisible="state != 'superseded'"/>
                    <widget name="web_ribbon" title="Obsolete" bg_color="text-bg-danger"
                            invisible="state != 'obsolete'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>
                            <span>Version </span>
                            <field name="version" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Production Context">
                            <field name="component_id" readonly="state != 'draft'"/>
                            <field name="tool_id" readonly="state != 'draft'"
                                   domain="[('component_ids', 'in', component_id)]"/>
                            <field name="workcenter_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Effectivity">
                            <field name="effective_date" readonly="state not in ('draft', 'review')"/>
                            <field name="review_interval_months" readonly="state == 'obsolete'"/>
                            <field name="next_review_date"/>
                            <field name="review_overdue"/>
                            <field name="previous_version_id" readonly="1"
                                   invisible="not previous_version_id"/>
                        </group>
                    </group>
                    <group string="Approval Record">
                        <group>
                            <field name="author_id" readonly="1"/>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="approver_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="parameter_count"/>
                            <field name="critical_parameter_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parameters" name="parameters">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-bf="is_critical">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="parameter_uom"/>
                                    <field name="value_type"/>
                                    <field name="min_value"/>
                                    <field name="target_value"/>
                                    <field name="max_value"/>
                                    <field name="expected_text" optional="show"/>
                                    <field name="is_critical"/>
                                    <field name="monitoring_frequency"/>
                                    <field name="record_required"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reason For Change" name="change">
                            <field name="change_reason" readonly="state not in ('draft', 'review')"
                                   placeholder="Justification for this version, mandatory from version 2 onwards"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mp_molding_parameter_search" model="ir.ui.view">
        <field name="name">ls.mp.molding_parameter.search</field>
        <field name="model">ls.mp.molding_parameter</field>
        <field name="arch" type="xml">
            <search string="Moulding Parameter Specifications">
                <field name="name"/>
                <field name="component_id"/>
                <field name="tool_id"/>
                <field name="workcenter_id"/>
                <field name="approver_id"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_review" string="Under Review" domain="[('state', '=', 'review')]"/>
                <filter name="filter_review_overdue" string="Review Overdue"
                        domain="[('review_overdue', '=', True)]"/>
                <filter name="filter_has_critical" string="Has Critical Parameters"
                        domain="[('critical_parameter_count', '>', 0)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_component" string="Component" context="{'group_by': 'component_id'}"/>
                    <filter name="group_tool" string="Tool" context="{'group_by': 'tool_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_workcenter" string="Work Centre" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mp_molding_parameter" model="ir.actions.act_window">
        <field name="name">Moulding Parameters</field>
        <field name="res_model">ls.mp.molding_parameter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mp_molding_parameter_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a moulding parameter specification</p>
            <p>A specification is the approved process window for one component on one
               tool. Only one version can be approved at a time; approving a new version
               supersedes the previous one automatically. The author of a specification
               may neither review nor approve it.</p>
        </field>
    </record>

    <record id="view_mp_molding_parameter_line_list" model="ir.ui.view">
        <field name="name">ls.mp.molding_parameter.line.list</field>
        <field name="model">ls.mp.molding_parameter.line</field>
        <field name="arch" type="xml">
            <list string="Moulding Parameters" create="false">
                <field name="spec_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="parameter_uom"/>
                <field name="min_value"/>
                <field name="target_value"/>
                <field name="max_value"/>
                <field name="is_critical"/>
                <field name="monitoring_frequency"/>
                <field name="state"/>
            </list>
        </field>
    </record>

</odoo>
