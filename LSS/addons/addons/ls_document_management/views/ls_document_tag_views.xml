<odoo>

    <record id="view_ls_document_tag_list" model="ir.ui.view">
        <field name="name">ls.document.tag.list</field>
        <field name="model">ls.document.tag</field>
        <field name="arch" type="xml">
            <list string="Document Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_document_tag_search" model="ir.ui.view">
        <field name="name">ls.document.tag.search</field>
        <field name="model">ls.document.tag</field>
        <field name="arch" type="xml">
            <search string="Document Tags">
                <field name="name"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ls_document_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">ls.document.tag</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_ls_document_tag_search"/>
    </record>

</odoo>
