<odoo>

    <record id="view_ls_document_link_list" model="ir.ui.view">
        <field name="name">ls.document.link.list</field>
        <field name="model">ls.document.link</field>
        <field name="arch" type="xml">
            <list string="Linked Records" editable="bottom">
                <field name="document_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="res_name"/>
                <field name="relation_type"/>
                <field name="note"/>
                <button name="action_open_linked_record" string="Open" type="object" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_ls_document_link_form" model="ir.ui.view">
        <field name="name">ls.document.link.form</field>
        <field name="model">ls.document.link</field>
        <field name="arch" type="xml">
            <form string="Linked Record">
                <header>
                    <button name="action_open_linked_record" string="Open Linked Record" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Document">
                            <field name="document_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Target">
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                            <field name="relation_type"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ls_document_link" model="ir.actions.act_window">
        <field name="name">Linked Records</field>
        <field name="res_model">ls.document.link</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
