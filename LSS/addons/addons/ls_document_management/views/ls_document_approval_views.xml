<odoo>

    <record id="view_ls_document_approval_list" model="ir.ui.view">
        <field name="name">ls.document.approval.list</field>
        <field name="model">ls.document.approval</field>
        <field name="arch" type="xml">
            <list string="Approvals" create="false" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="document_id"/>
                <field name="version_id"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"/>
                <field name="decision_date"/>
                <field name="comment" optional="show"/>
                <button name="action_approve" string="Approve" type="object" icon="fa-check" invisible="state != 'pending'"/>
                <button name="action_reject" string="Reject" type="object" icon="fa-times" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_ls_document_approval_form" model="ir.ui.view">
        <field name="name">ls.document.approval.form</field>
        <field name="model">ls.document.approval</field>
        <field name="arch" type="xml">
            <form string="Approval" create="false">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Subject">
                            <field name="document_id"/>
                            <field name="version_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Decision">
                            <field name="approver_id"/>
                            <field name="decision_date"/>
                        </group>
                    </group>
                    <group string="Comment">
                        <field name="comment" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_document_approval_search" model="ir.ui.view">
        <field name="name">ls.document.approval.search</field>
        <field name="model">ls.document.approval</field>
        <field name="arch" type="xml">
            <search string="Approvals">
                <field name="document_id"/>
                <field name="approver_id"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_mine" string="Assigned to Me" domain="[('approver_id', '=', uid)]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="group_by_state" string="Decision" context="{'group_by': 'state'}"/>
                    <filter name="group_by_approver" string="Approver" context="{'group_by': 'approver_id'}"/>
                    <filter name="group_by_document" string="Document" context="{'group_by': 'document_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ls_document_approval" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">ls.document.approval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_document_approval_search"/>
        <field name="context">{'search_default_filter_pending': 1, 'search_default_filter_mine': 1}</field>
    </record>

</odoo>
