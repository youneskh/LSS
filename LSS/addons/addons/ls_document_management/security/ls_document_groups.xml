<odoo>

    <record id="module_category_life_sciences" model="ir.module.category">
        <field name="name">Life Sciences</field>
        <field name="description">Life Sciences Suite applications.</field>
        <field name="sequence">90</field>
    </record>

    <record id="privilege_ls_document" model="res.groups.privilege">
        <field name="name">Document Management</field>
        <field name="category_id" ref="module_category_life_sciences"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_ls_document_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_ls_document"/>
        <field name="sequence">10</field>
        <field name="comment">Read-only access to controlled documents and their version history.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ls_document_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="privilege_id" ref="privilege_ls_document"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_ls_document_viewer'))]"/>
        <field name="comment">Creates documents, uploads new versions and submits them for review.</field>
    </record>

    <record id="group_ls_document_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_ls_document"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_ls_document_viewer'))]"/>
        <field name="comment">Records approval decisions. Does not imply the Editor role, so that authoring and approval stay segregated.</field>
    </record>

    <record id="group_ls_document_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ls_document"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_ls_document_editor')), (4, ref('group_ls_document_approver'))]"/>
        <field name="comment">Configures folders, tags and retention policies, publishes and archives documents.</field>
    </record>

</odoo>
