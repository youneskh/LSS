<odoo>

    <record id="view_ls_signature_session_list" model="ir.ui.view">
        <field name="name">ls.signature.session.list</field>
        <field name="model">ls.signature.session</field>
        <field name="arch" type="xml">
            <list string="Signing Sessions" create="false" delete="false"
                  decoration-muted="closed">
                <field name="user_id"/>
                <field name="first_signed_at"/>
                <field name="last_signed_at"/>
                <field name="signature_count"/>
                <field name="closed"/>
                <field name="close_reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_close" type="object" string="Close"
                        icon="fa-times-circle" invisible="closed"
                        groups="ls_electronic_signature.group_ls_signature_manager"/>
            </list>
        </field>
    </record>

    <record id="view_ls_signature_session_search" model="ir.ui.view">
        <field name="name">ls.signature.session.search</field>
        <field name="model">ls.signature.session</field>
        <field name="arch" type="xml">
            <search string="Signing Sessions">
                <field name="user_id"/>
                <filter name="filter_open" string="Open" domain="[('closed', '=', False)]"/>
                <filter name="filter_closed" string="Closed" domain="[('closed', '=', True)]"/>
                                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_reason" string="Close Reason"
                        context="{'group_by': 'close_reason'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_signature_session" model="ir.actions.act_window">
        <field name="name">Signing Sessions</field>
        <field name="res_model">ls.signature.session</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_ls_signature_session_search"/>
        <field name="context">{'create': False, 'search_default_filter_open': 1}</field>
    </record>

</odoo>
