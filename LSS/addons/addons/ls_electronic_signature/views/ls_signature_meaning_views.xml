<odoo>

    <record id="view_ls_signature_meaning_list" model="ir.ui.view">
        <field name="name">ls.signature.meaning.list</field>
        <field name="model">ls.signature.meaning</field>
        <field name="arch" type="xml">
            <list string="Signature Meanings">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="require_reason"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ls_signature_meaning_form" model="ir.ui.view">
        <field name="name">ls.signature.meaning.form</field>
        <field name="model">ls.signature.meaning</field>
        <field name="arch" type="xml">
            <form string="Signature Meaning">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code" placeholder="APPROVED"/>
                            <field name="name" placeholder="Approved by"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="require_reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Shown to the signer in the signature dialog."/>
                    </group>
                    <group string="Authorised Groups">
                        <field name="group_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_signature_meaning_search" model="ir.ui.view">
        <field name="name">ls.signature.meaning.search</field>
        <field name="model">ls.signature.meaning</field>
        <field name="arch" type="xml">
            <search string="Signature Meanings">
                <field name="code"/>
                <field name="name"/>
                <filter name="filter_reason_required" string="Reason Mandatory"
                        domain="[('require_reason', '=', True)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                                    <filter name="group_company" string="Company"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_signature_meaning" model="ir.actions.act_window">
        <field name="name">Signature Meanings</field>
        <field name="res_model">ls.signature.meaning</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_signature_meaning_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a signature meaning</p>
            <p>
                21 CFR 11.50(a)(3) requires every signed electronic record to indicate
                the meaning associated with the signature.
            </p>
        </field>
    </record>

</odoo>
