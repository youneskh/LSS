+        :return: a ``stock.lot`` recordset (superuser environment).
+        """
+        self.ensure_one()
+        move_line_model = self.env["stock.move.line"].sudo()
+        lots = self.lot_ids.sudo()
+        frontier = lots
+        while frontier:
+            consumed = move_line_model.search(
+                [
