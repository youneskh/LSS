-    method_description = fields.Text()
-
-    # ------------------------------------------------------------------
-    # Workflow
-    # ------------------------------------------------------------------
-    state = fields.Selection(
-        selection=constants.PLAN_STATE_SELECTION,
-        string="Status",
-        required=True,
