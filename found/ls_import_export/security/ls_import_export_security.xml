<odoo>

    <!--
        Odoo 19 restructured access rights: res.groups.category_id was
        replaced by res.groups.privilege_id, pointing at the new
        res.groups.privilege model, which in turn carries the module
        category. The structure below follows that model, matching the
        pattern used in ls_recall and ls_qms.
    -->

    <record id="module_category_ls_import_export" model="ir.module.category">
        <field name="name">Life Sciences</field>
        <field name="description">Import &amp; export compliance applications
            of the Life Sciences Suite.</field>
        <field name="sequence">85</field>
    </record>

    <record id="privilege_ls_import_export" model="res.groups.privilege">
        <field name="name">Import &amp; Export Compliance</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ls_import_export"/>
    </record>

    <!--
        Four roles, each implying the one below it.

        Registry editing (creating or editing a provision) is restricted
        to the manager group: the registry is the trusted root of the
        whole module, so editing a provision is a regulated act
        (deviation D-03, doc/05_architecture_review.md).
    -->

    <record id="group_ls_import_export_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_ls_import_export"/>
        <field name="comment">Read-only access to the registry and to
            operations. Intended for auditors, inspectors' escorts and
            management.</field>
    </record>

    <record id="group_ls_import_export_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_ls_import_export"/>
        <field name="implied_ids" eval="[Command.link(ref('group_ls_import_export_viewer'))]"/>
        <field name="comment">Operates imports and exports and reads the
            registry. Cannot edit provisions.</field>
    </record>

    <record id="group_ls_import_export_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_ls_import_export"/>
        <field name="implied_ids" eval="[Command.link(ref('group_ls_import_export_user'))]"/>
        <field name="comment">Manages authorisations, customs
            declarations and banking files. May create compliance
            requirements that cite provisions, but may not create or
            edit provisions.</field>
    </record>

    <record id="group_ls_import_export_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ls_import_export"/>
        <field name="implied_ids" eval="[Command.link(ref('group_ls_import_export_officer'))]"/>
        <field name="comment">Owns the registry: the only role that may
            create or edit provisions, because the registry is the
            trusted root of the whole module.</field>
    </record>

    <!--
        Multi-company isolation, global rules following the Odoo 19
        multi-company pattern used in ls_recall.
    -->

    <record id="rule_ls_import_export_provision_company" model="ir.rule">
        <field name="name">Import/Export Provision: multi-company</field>
        <field name="model_id" ref="model_ls_import_export_provision"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_import_export_citation_company" model="ir.rule">
        <field name="name">Import/Export Citation: multi-company</field>
        <field name="model_id" ref="model_ls_import_export_provision_citation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_import_export_requirement_company" model="ir.rule">
        <field name="name">Import/Export Requirement: multi-company</field>
        <field name="model_id" ref="model_ls_import_export_compliance_requirement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ls_import_export_question_company" model="ir.rule">
        <field name="name">Import/Export Regulatory Question: multi-company</field>
        <field name="model_id" ref="model_ls_import_export_regulatory_question"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
