<odoo noupdate="1">

    <!--
        DESIGN NOTE - deliberately global rules.

        The name of the many2many field linking ir.rule to res.groups in
        Odoo 19 could not be verified from official documentation. Writing an
        unverified field name into a data file would make the module fail to
        install.

        Every rule below is therefore GLOBAL: it declares no group and
        applies to all users. Global rules are combined with AND, so they
        constrain every user including the ones holding the Manager group.
        They are used for multi-company isolation only.

        Role-based restriction is delivered by two other mechanisms that do
        not depend on the unverified field name:
          1. ir.model.access.csv, which grants CRUD per group;
          2. ORM-level checks in Python (state machines, segregation of
             duties, immutability after approval), which hold regardless of
             how the record is reached.

        The computed field ir.rule.global is never written explicitly, since
        it is derived by the framework from the absence of groups.
    -->

    <record id="rule_ls_calibration_instrument_category_company" model="ir.rule">
        <field name="name">Instrument Category: multi-company</field>
        <field name="model_id" ref="model_ls_calibration_instrument_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

