<odoo>

    <record id="action_report_ls_calibration_certificate" model="ir.actions.report">
        <field name="name">Calibration Certificate</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_calibration.report_ls_calibration_certificate</field>
        <field name="report_file">ls_calibration.report_ls_calibration_certificate</field>
        <field name="binding_model_id" ref="model_ls_calibration_certificate"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Calibration Certificate - %s' % (object.name)</field>
    </record>

    <record id="action_report_ls_calibration_record" model="ir.actions.report">
        <field name="name">Calibration Record</field>
        <field name="model">ls.calibration.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ls_calibration.report_ls_calibration_record</field>
        <field name="report_file">ls_calibration.report_ls_calibration_record</field>
        <field name="binding_model_id" ref="model_ls_calibration_record"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Calibration Record - %s' % (object.name)</field>
    </record>

</odoo>
