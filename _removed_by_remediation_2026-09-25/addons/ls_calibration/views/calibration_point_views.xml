<odoo>

    <record id="view_ls_calibration_point_list" model="ir.ui.view">
        <field name="name">ls.calibration.point.list</field>
        <field name="model">ls.calibration.point</field>
        <field name="arch" type="xml">
            <list string="Calibration Points">
                <field name="sequence" widget="handle"/>
                <field name="instrument_id"/>
                <field name="name"/>
                <field name="nominal_value"/>
                <field name="unit_label"/>
                <field name="tolerance_type"/>
                <field name="tolerance_value"/>
                <field name="tolerance_absolute"/>
                <field name="lower_limit"/>
                <field name="upper_limit"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_calibration_point_form" model="ir.ui.view">
        <field name="name">ls.calibration.point.form</field>
        <field name="model">ls.calibration.point</field>
        <field name="arch" type="xml">
            <form string="Calibration Point">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Mid-scale"/></h1>
                    </div>
                    <group>
                        <group string="Point">
                            <field name="instrument_id"/>
                            <field name="sequence"/>
                            <field name="nominal_value"/>
                            <field name="unit_label" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Acceptance Criteria">
                            <field name="tolerance_type"/>
                            <field name="tolerance_value"/>
                            <field name="tolerance_absolute" readonly="1"/>
                            <field name="lower_limit" readonly="1"/>
                            <field name="upper_limit" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        A percentage tolerance is expressed in percent: enter
                        <strong>0.5</strong> for 0.5 %, not 50. Acceptance criteria become
                        read-only once the point has been used in a calibration that
                        passed data entry.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ls_calibration_point_search" model="ir.ui.view">
        <field name="name">ls.calibration.point.search</field>
        <field name="model">ls.calibration.point</field>
        <field name="arch" type="xml">
            <search string="Calibration Points">
                <field name="name"/>
                <field name="instrument_id"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                                    <filter name="group_instrument" string="Instrument"
                        context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_tolerance_type" string="Tolerance Type"
                        context="{'group_by': 'tolerance_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_calibration_point" model="ir.actions.act_window">
        <field name="name">Calibration Points</field>
        <field name="res_model">ls.calibration.point</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_calibration_point_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a calibration point</p>
            <p>
                A calibration point is one nominal value at which the instrument is
                verified, together with the tolerance applied at that value.
            </p>
        </field>
    </record>

</odoo>
