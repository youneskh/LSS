<odoo>

    <record id="view_ls_calibration_certificate_list" model="ir.ui.view">
        <field name="name">ls.calibration.certificate.list</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="arch" type="xml">
            <list string="Calibration Certificates">
                <field name="name"/>
                <field name="instrument_id"/>
                <field name="record_id"/>
                <field name="certificate_type"/>
                <field name="issue_date"/>
                <field name="valid_until"/>
                <field name="issuer_name" optional="show"/>
                <field name="issuer_partner_id" optional="hide"/>
                <field name="overall_result" widget="badge"
                       decoration-danger="overall_result == 'fail'"
                       decoration-success="overall_result == 'pass'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ls_calibration_certificate_form" model="ir.ui.view">
        <field name="name">ls.calibration.certificate.form</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="arch" type="xml">
            <form string="Calibration Certificate">
                <header>
                    <button name="action_print" type="object" string="Print Certificate"
                            class="oe_highlight" invisible="certificate_type != 'internal'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="record_id"/>
                            <field name="instrument_id" readonly="1"/>
                            <field name="overall_result" readonly="1" widget="badge"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Issue">
                            <field name="certificate_type"/>
                            <field name="issue_date"/>
                            <field name="valid_until" readonly="1"/>
                            <field name="issuer_name"/>
                            <field name="issuer_partner_id"
                                   invisible="certificate_type != 'external'"/>
                            <field name="accreditation_reference"
                                   invisible="certificate_type != 'external'"/>
                        </group>
                    </group>
                    <group string="Document">
                        <field name="document" filename="document_filename"
                               required="certificate_type == 'external'"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ls_calibration_certificate_search" model="ir.ui.view">
        <field name="name">ls.calibration.certificate.search</field>
        <field name="model">ls.calibration.certificate</field>
        <field name="arch" type="xml">
            <search string="Calibration Certificates">
                <field name="name"/>
                <field name="instrument_id"/>
                <field name="record_id"/>
                <field name="issuer_name"/>
                <filter name="filter_internal" string="Internal"
                        domain="[('certificate_type', '=', 'internal')]"/>
                <filter name="filter_external" string="External"
                        domain="[('certificate_type', '=', 'external')]"/>
                <separator/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                                    <filter name="group_instrument" string="Instrument"
                        context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_type" string="Certificate Type"
                        context="{'group_by': 'certificate_type'}"/>
                    <filter name="group_issue" string="Issue Month"
                        context="{'group_by': 'issue_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_ls_calibration_certificate" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">ls.calibration.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ls_calibration_certificate_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a calibration certificate</p>
            <p>
                Certificates evidence an approved calibration. Internal certificates
                are printed from this module; external certificates are stored as the
                document received from the issuing laboratory.
            </p>
        </field>
    </record>

</odoo>
